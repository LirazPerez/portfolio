---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import WorkCard from '../components/WorkCard.astro';
import AiLab from '../components/AiLab.astro';
import FallingFacts from '../components/FallingFacts';
import { FACTS } from '../data/facts';
import portrait from '../assets/liraz-portrait.jpg';

const work = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title="Home">
  <div class="mx-auto max-w-content px-[clamp(16px,5vw,56px)]">
    <section
      class="hero grid gap-x-[clamp(24px,4vw,56px)] gap-y-5 items-center pt-[clamp(40px,8vw,84px)] pb-[clamp(28px,5vw,48px)] md:grid-cols-[minmax(0,1.2fr)_minmax(0,1fr)]"
      aria-labelledby="hero-h"
    >
      <div class="grid gap-[18px] min-w-0">
        <p class="m-0 text-[14px] font-medium text-muted">Liraz Hazala Perez · Product Designer</p>
        <h1 id="hero-h" class="m-0 text-[clamp(30px,4.6vw,52px)] leading-[1.12] tracking-[-0.025em] font-semibold text-balance">
          For nine years, I ran complex operations by <em class="not-italic text-accent">watching them closely</em>. Now I design and build products.
        </h1>
        <p class="m-0 text-[18px] leading-[1.6] text-muted max-w-[60ch]">
          From a war room to international defense programs, I learned to notice what breaks before it breaks. I bring that to product design, from research to working code.
        </p>
        <div class="flex flex-wrap gap-[10px]">
          <a class="inline-flex items-center min-h-[44px] px-[18px] rounded-pill bg-accent text-on-accent text-[15px] font-medium no-underline hover:bg-accent-strong transition-colors" href="#work">See the work</a>
          <a class="inline-flex items-center min-h-[44px] px-[18px] rounded-pill border border-line text-ink text-[15px] font-medium no-underline hover:bg-surface transition-colors" href="/about">How I got here</a>
        </div>
      </div>

      <div class="drop-zone relative mb-[36px]">
        <figure class="m-0 relative overflow-hidden rounded-card border border-line bg-surface aspect-[4/5] md:aspect-[4/4.6]">
          <Image
            src={portrait}
            alt="Portrait of Liraz Hazala Perez: long wavy brown hair, a grey sweatshirt with a rust-red stripe, looking at the camera."
            widths={[360, 530]}
            sizes="(min-width: 760px) 440px, 100vw"
            loading="eager"
            class="block w-full h-full object-cover object-[50%_8%] md:object-[50%_18%]"
          />
        </figure>
        <!-- Server-rendered as the static resting layout; hydrates when scrolled into view, then drops once. -->
        <FallingFacts client:visible facts={FACTS} />
      </div>
    </section>

    <section id="work" class="grid gap-2.5 pt-3 pb-6" aria-labelledby="work-h">
      <h2 id="work-h" class="m-0 text-[22px] font-semibold tracking-[-0.012em]">Selected work</h2>
      <div class="grid gap-2.5 md:grid-cols-2">
        {work.map((entry) => <WorkCard entry={entry} />)}
      </div>
    </section>

    <AiLab />
  </div>
</BaseLayout>
