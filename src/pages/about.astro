---
/**
 * About. All copy and numbers live in src/data/about.ts; this file is layout only.
 */
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import PathTimeline from '../components/about/PathTimeline.astro';
import ClayFrame from '../components/about/ClayFrame.astro';
import PathObjects from '../components/about/PathObjects.astro';
import BackToTop from '../components/BackToTop.astro';
import { aboutPhoto } from '../lib/about-media';
import { CV_HREF, CV_SIZE_LABEL } from '../lib/cv';
import { ABOUT_TITLE, OPENING, PATH, CERTIFICATES, BEFORE_DESIGN, DESIGN_BUILD_RUN, OFF_THE_CLOCK, CLOSING } from '../data/about';

const container = 'mx-auto max-w-content px-[clamp(16px,5vw,56px)]';
const section = 'grid gap-3 pt-[clamp(64px,10vw,112px)]';
const h2 = 'm-0 text-[clamp(24px,3vw,32px)] leading-[1.2] font-semibold tracking-[-0.02em] text-balance';
const sub = 'm-0 text-[17px] leading-[1.6] text-muted max-w-[60ch]';

// Split a line around its link words ("Training with Neta, the coach app...").
const splitLink = (line: string, link?: { text: string }) => {
  const i = link ? line.indexOf(link.text) : -1;
  return i < 0 || !link ? null : [line.slice(0, i), line.slice(i + link.text.length)];
};
---

<BaseLayout title={ABOUT_TITLE} description={OPENING.lede}>
  <!-- 1. Opening -->
  <div class={container}>
    <!-- Text, and beside it (under it on phones) four clay objects from the home page, one per
         row of "My path". (The portrait stays in src/assets/about/ in case it comes back.) -->
    <header class="grid gap-3 pt-[clamp(24px,4vw,56px)] md:grid-cols-[minmax(0,1fr)_auto] md:items-center md:gap-4 lg:gap-6">
      <div class="grid gap-[18px] min-w-0">
        <p class="m-0 text-[14px] font-medium text-muted">{OPENING.eyebrow}</p>
        <h1 class="m-0 max-w-[18ch] text-[clamp(32px,4.6vw,52px)] leading-[1.12] tracking-[-0.025em] font-semibold text-balance">
          {OPENING.headline.lead} <em class="not-italic text-accent">{OPENING.headline.accent}</em>
        </h1>
        <p class="m-0 text-[18px] leading-[1.6] text-muted max-w-[60ch]">{OPENING.lede}</p>
        <ul role="list" class="m-0 p-0 list-none flex flex-wrap gap-1">
          {OPENING.pills.map((pill) => <li class="text-[13px] border border-line rounded-pill px-[12px] py-[5px] bg-raise">{pill}</li>)}
        </ul>
      </div>
      <PathObjects />
    </header>
  </div>

  <div class={container}>
    <!-- 2. My path: the full content width, wider than the reading column -->
    <!-- Closer to the opening than the other sections, so the timeline starts on the first screen. -->
    <section class="grid gap-3 pt-[clamp(40px,5vw,64px)]" aria-labelledby="path-h">
      <div class="grid gap-1">
        <h2 id="path-h" tabindex="-1" class={h2}>{PATH.heading}</h2>
        <!-- Which line shows depends on the device: a mouse, or a touch screen. -->
        <p class="path-hint m-0 text-[15px] text-muted">
          <span class="hint-pointer">{PATH.hint.pointer}</span><span class="hint-touch">{PATH.hint.touch}</span>
        </p>
      </div>
      <PathTimeline />
    </section>

    <!-- 3. Certificates -->
    <section class={section} aria-labelledby="certs-h">
      <h2 id="certs-h" class={h2}>{CERTIFICATES.heading}</h2>
      <!-- A 12-column grid from 1024px: three big cards (4 columns each), then four compact
           ones (3 each). Two columns on tablets, one on phones. -->
      <ul role="list" class="m-0 p-0 list-none grid gap-2 pt-1 md:grid-cols-2 lg:grid-cols-12">
        {
          CERTIFICATES.items.map((c) => (
            <li class:list={['cert', c.compact ? 'lg:col-span-3' : 'lg:col-span-4']}>
              <ClayFrame>
                <div class:list={['cert-body', c.compact && 'cert-body--compact']}>
                  <p class="cert-issuer m-0 text-muted">{c.issuer}</p>
                  <h3 class="cert-title m-0 font-semibold tracking-[-0.01em] text-balance">{c.title}</h3>
                  <p class="cert-line m-0">{c.line}</p>
                  <p class="cert-foot m-0 flex items-center justify-between gap-2 font-medium">
                    <span class="text-muted">{c.years}</span>
                    {c.deansList && <span class="font-semibold text-accent-strong">{CERTIFICATES.deansListLabel}</span>}
                  </p>
                </div>
              </ClayFrame>
            </li>
          ))
        }
      </ul>
    </section>

    <!-- 4. Before design -->
    <section class={section} aria-labelledby="before-h">
      <div class="grid gap-1">
        <h2 id="before-h" class={h2}>{BEFORE_DESIGN.heading}</h2>
        <p class={sub}>{BEFORE_DESIGN.subtitle}</p>
      </div>
      <ul role="list" class="m-0 p-0 list-none grid gap-px bg-line border border-line rounded-card overflow-hidden mt-1 md:grid-cols-2 lg:grid-cols-3">
        {
          BEFORE_DESIGN.stats.map((s) => (
            <li class="bg-bg flex flex-col gap-1 p-3">
              <p class="m-0 text-[clamp(36px,4vw,46px)] leading-none font-semibold tracking-[-0.03em]">
                {s.spoken ? (<><span aria-hidden="true">{s.value}</span><span class="sr-only-text">{s.spoken}</span></>) : s.value}
              </p>
              <p class="m-0 text-[16px] leading-[1.5]">{s.text}</p>
              <p class="m-0 mt-auto pt-1 flex items-center gap-1 text-[13px] text-muted">
                <span class="w-[8px] h-[8px] rounded-pill shrink-0" style={`background: var(--path-${s.family})`} aria-hidden="true" />
                {s.source}
              </p>
            </li>
          ))
        }
      </ul>
    </section>

    <!-- 5. Design, build, run -->
    <section class={section} aria-labelledby="dbr-h">
      <h2 id="dbr-h" class={h2}>{DESIGN_BUILD_RUN.heading}</h2>
      <ul role="list" class="m-0 p-0 list-none grid gap-2.5 pt-1 md:grid-cols-2">
        {
          DESIGN_BUILD_RUN.cards.map((card) => (
            <li class="grid content-start gap-1.5 border border-line rounded-card p-3">
              <h3 class="m-0 text-[19px] font-semibold tracking-[-0.01em]">{card.title}</h3>
              <ul role="list" class="m-0 p-0 list-none grid gap-1">
                {card.points.map((point) => (
                  <li class="grid grid-cols-[6px_minmax(0,1fr)] gap-1.5 items-baseline text-[16px] leading-[1.5]">
                    <span class="w-[6px] h-[6px] rounded-pill bg-accent -translate-y-[2px]" aria-hidden="true" />
                    {point}
                  </li>
                ))}
              </ul>
            </li>
          ))
        }
      </ul>
    </section>

    <!-- 6. Off the clock -->
    <section class={section} aria-labelledby="clock-h">
      <div class="grid gap-1">
        <h2 id="clock-h" class={h2}>{OFF_THE_CLOCK.heading}</h2>
        <p class={sub}>{OFF_THE_CLOCK.subtitle}</p>
      </div>
      <ul role="list" class="m-0 p-0 list-none grid grid-cols-2 gap-x-2 gap-y-3 pt-1 md:grid-cols-4 md:gap-x-2.5">
        {
          OFF_THE_CLOCK.items.map((item) => {
            const photo = aboutPhoto(item.photo);
            const parts = splitLink(item.line, item.link);
            return (
              <li class="grid content-start gap-1 min-w-0">
                <div class="aspect-[4/5] rounded-card overflow-hidden bg-surface">
                  {photo && (
                    <Image src={photo} alt={item.alt} widths={[240, 360, 520, 720].filter((w) => w <= photo.width)} sizes="(min-width: 760px) 260px, 45vw" class="block w-full h-full object-cover" />
                  )}
                </div>
                <h3 class="m-0 pt-0.5 text-[16px] font-semibold">{item.title}</h3>
                <p class="m-0 text-[14.5px] leading-[1.5] text-muted">
                  {parts && item.link ? (<>{parts[0]}<a class="prose-link" href={item.link.href}>{item.link.text}</a>{parts[1]}</>) : item.line}
                </p>
              </li>
            );
          })
        }
      </ul>
    </section>

    <!-- 7. Closing -->
    <!-- No divider: the contact panel right below already starts a new block. The line is set
         in Caveat, like the signature: a personal note. -->
    <section class="pt-[clamp(56px,9vw,96px)] flex flex-wrap items-center justify-between gap-2" aria-labelledby="short-h">
      <h2 id="short-h" class="m-0 font-signature font-semibold text-[clamp(30px,3.4vw,34px)] leading-[1.1] text-ink">{CLOSING.heading}</h2>
      <div class="flex flex-wrap gap-[10px]">
        <a class="inline-flex items-center min-h-[44px] px-[18px] rounded-pill bg-accent text-on-accent text-[15px] font-medium no-underline hover:bg-accent-strong transition-colors" href={CV_HREF} download>
          {CLOSING.cv}<span class="sr-only-text">, {CV_SIZE_LABEL}</span>
        </a>
      </div>
    </section>
  </div>
  <BackToTop />
</BaseLayout>

<style>
  /* The hint names the gesture the device has. Without JS the timeline can't open anything,
     so the hint is hidden. */
  .hint-touch { display: none; }
  @media (pointer: coarse) {
    .hint-pointer { display: none; }
    .hint-touch { display: inline; }
  }
  @media (hover: hover) and (pointer: fine) {
    .hint-pointer { display: inline; }
    .hint-touch { display: none; }
  }
  :global(html:not(.js)) .path-hint { display: none; }

  .cert { transition: transform 0.25s ease; }
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .cert:hover { transform: translateY(-3px); }
  }
  /* Issuer, title and line at the top; the year line at the bottom, so cards in a row
     line up their years. */
  .cert-body {
    display: grid;
    grid-template-rows: auto auto auto 1fr;
    gap: 6px;
    height: 100%;
    padding: 14px;
  }
  .cert-issuer { font-size: 13px; line-height: 1.4; }
  .cert-title { font-size: 16px; line-height: 1.3; }
  .cert-line { font-size: 14.5px; line-height: 1.5; }
  .cert-foot { align-self: end; padding-top: 6px; font-size: 13.5px; }
  .cert-body--compact { gap: 4px; }
  .cert-body--compact .cert-issuer { font-size: 12.5px; }
  .cert-body--compact .cert-title { font-size: 15px; }
  .cert-body--compact .cert-line { font-size: 13.5px; line-height: 1.45; color: var(--muted); }
</style>
