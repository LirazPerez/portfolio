---
import { render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CaseHero from '../../components/case/CaseHero.astro';
import Intro from '../../components/case/Intro.astro';
import Converge from '../../components/case/Converge.astro';
import Compare from '../../components/case/Compare.astro';
import StatRow from '../../components/case/StatRow.astro';
import StakeholderMap from '../../components/case/StakeholderMap.astro';
import MapLegend from '../../components/case/MapLegend.astro';
import ProcessFlow from '../../components/case/ProcessFlow.astro';
import DidInstead from '../../components/case/DidInstead.astro';
import Decision from '../../components/case/Decision.astro';
import BuildSplit from '../../components/case/BuildSplit.astro';
import OutcomeStats from '../../components/case/OutcomeStats.astro';
import OpenCards from '../../components/case/OpenCards.astro';
import FailureModes from '../../components/case/FailureModes.astro';
import GapMatrix from '../../components/case/GapMatrix.astro';
import PivotNote from '../../components/case/PivotNote.astro';
import Persona from '../../components/case/Persona.astro';
import FlowRow from '../../components/case/FlowRow.astro';
import ComponentStrip from '../../components/case/ComponentStrip.astro';
import TagOptions from '../../components/case/TagOptions.astro';
import ScopeSplit from '../../components/case/ScopeSplit.astro';
import EdgeCards from '../../components/case/EdgeCards.astro';
import SubIntro from '../../components/case/SubIntro.astro';
import ClipFrame from '../../components/case/ClipFrame.astro';
import HrDrift from '../../components/case/HrDrift.astro';
import CompareTable from '../../components/case/CompareTable.astro';
import RuleCards from '../../components/case/RuleCards.astro';
import DeviceFigures from '../../components/case/DeviceFigures.astro';
import MomentColumns from '../../components/case/MomentColumns.astro';
import TwoUp from '../../components/case/TwoUp.astro';
import Shot from '../../components/case/Shot.astro';
import Timeline from '../../components/case/Timeline.astro';
import PromptSample from '../../components/case/PromptSample.astro';
import PathCompare from '../../components/case/PathCompare.astro';
import RecordMap from '../../components/case/RecordMap.astro';
import RoleMap from '../../components/case/RoleMap.astro';
import DataLayer from '../../components/case/DataLayer.astro';
import UserLoops from '../../components/case/UserLoops.astro';
import PriorityBoard from '../../components/case/PriorityBoard.astro';
import PhoneRow from '../../components/case/PhoneRow.astro';
import DeviceCompare from '../../components/case/DeviceCompare.astro';
import SpecLine from '../../components/case/SpecLine.astro';
import StatesGrid from '../../components/case/StatesGrid.astro';
import ProofCards from '../../components/case/ProofCards.astro';
import CaseStudyToc from '../../components/CaseStudyToc.astro';
import Screen from '../../components/Screen.astro';
import ExternalLink from '../../components/ExternalLink.astro';
import { SECTIONS, sectionsIn } from '../../lib/case-study';
import { publishedWork } from '../../lib/work';

export async function getStaticPaths() {
  const work = await publishedWork();
  // "Next project" only ever points at a written case study, never a coming-soon one.
  return work.map((entry, i) => ({
    params: { slug: entry.id },
    props: { entry, next: work.slice(i + 1).find((e) => !e.data.comingSoon) ?? null },
  }));
}

interface Props {
  entry: CollectionEntry<'work'>;
  next: CollectionEntry<'work'> | null;
}
const { entry, next } = Astro.props;
const { title, tagline, comingSoon } = entry.data;
const { Content } = await render(entry);
// Until a case study is written, render the outline with placeholder copy.
const hasBody = (entry.body ?? '').trim().length > 0;
// A coming-soon project whose case study is written renders in full here, for review, while
// its home card stays "coming soon" and links nowhere; the page stays out of search engines.
const soon = comingSoon && !hasBody;
const sections = hasBody ? sectionsIn(entry.body ?? '') : SECTIONS.filter((s) => !('optional' in s));

const PLACEHOLDER: Record<(typeof SECTIONS)[number]['id'], string> = {
  'what-i-noticed': 'The observation that started this project: the one detail I saw that others walked past.',
  problem: 'Who was stuck, where, and what it cost them, in one or two sentences.',
  system: 'How the product is put together, and who sees what.',
  'how-i-ran-it': 'How I scoped and ran the project: the research, the constraints, the timeline and who I worked with.',
  process: 'The path from research to design: what I tested, what I learned, and what changed because of it.',
  decisions: 'The calls that shaped the product, with the options I rejected and why.',
  build: 'How the design became working code, and what building it taught me about the design.',
  outcome: 'What changed, measured where I could measure it, and honest about what did not.',
  'still-open': 'What I would do next, and the questions this project left me with.',
};
---

<BaseLayout title={title} description={tagline} noindex={comingSoon}>
  <article class="mx-auto max-w-content px-[clamp(16px,5vw,56px)] pt-[clamp(32px,6vw,64px)]" aria-labelledby="cs-title">
    <CaseHero entry={entry} soon={soon} />

    {
      soon ? (
        <section class="soon grid gap-1 justify-items-center text-center pt-2 pb-8" aria-labelledby="soon-h">
          <h2 id="soon-h" class="m-0 text-[clamp(24px,3vw,32px)] font-semibold tracking-[-0.012em]">Case study coming soon</h2>
          <p class="m-0 max-w-[52ch] text-[17px] leading-relaxed text-muted">
            I'm still building {title}. The full story, with screens and the decisions behind them, is on its way.
          </p>
        </section>
      ) : (
    <div class="grid gap-4 pt-2 pb-8 lg:grid-cols-[200px_minmax(0,1fr)] lg:gap-6">
      <CaseStudyToc sections={sections} />
      <div class="case-body grid min-w-0">
        {
          hasBody ? (
            <Content
              components={{
                Screen,
                ExternalLink,
                Intro,
                Converge,
                Compare,
                StatRow,
                StakeholderMap,
                MapLegend,
                ProcessFlow,
                DidInstead,
                Decision,
                BuildSplit,
                OutcomeStats,
                OpenCards,
                FailureModes,
                GapMatrix,
                PivotNote,
                Persona,
                FlowRow,
                ComponentStrip,
                TagOptions,
                ScopeSplit,
                EdgeCards,
                SubIntro,
                ClipFrame,
                HrDrift,
                CompareTable,
                RuleCards,
                DeviceFigures,
                MomentColumns,
                TwoUp,
                Shot,
                Timeline,
                PromptSample,
                PathCompare,
                RecordMap,
                RoleMap,
                DataLayer,
                UserLoops,
                PriorityBoard,
                PhoneRow,
                DeviceCompare,
                SpecLine,
                StatesGrid,
                ProofCards,
              }}
            />
          ) : (
            sections.map((s) => (
              <section id={s.id} class="cs-section" aria-labelledby={`${s.id}-heading`}>
                <h2 id={`${s.id}-heading`}>{'heading' in s ? s.heading : s.title}</h2>
                <p>
                  <span class="placeholder-tag">Placeholder</span> {PLACEHOLDER[s.id]}
                </p>
              </section>
            ))
          )
        }
      </div>
    </div>
      )
    }

    {
      next && (
        <nav class="next border-t border-line pt-4" aria-label="Next project">
          <a
            class="next-link group grid gap-1 p-[clamp(16px,3vw,24px)] rounded-frame border border-line bg-surface no-underline text-inherit"
            href={`/work/${next.id}`}
          >
            <span class="text-[13px] font-semibold text-accent-strong">Next project</span>
            <span class="text-[26px] font-semibold tracking-[-0.015em]">{next.data.title}</span>
            <span class="text-[16px] leading-relaxed text-muted max-w-[60ch]">{next.data.tagline}</span>
            <span class="more inline-flex items-center gap-[6px] pt-1 text-[15px] font-semibold text-accent-strong">
              View {next.data.title} <i class="not-italic" aria-hidden="true">→</i>
            </span>
          </a>
        </nav>
      )
    }
  </article>
</BaseLayout>

<style>
  /* Components inside a case study size themselves against this container, so a layout
     follows the room it really has (the TOC takes a column from 1024px). */
  .case-body {
    container: case / inline-size;
    gap: clamp(64px, 9vw, 96px);
  }
  .case-body :global(.cs-section) {
    display: grid;
    gap: 20px;
    min-width: 0;
    scroll-margin-top: 88px;
  }
  @media (max-width: 63.99rem) {
    /* Room for the sticky "On this page" bar. */
    .case-body :global(.cs-section) {
      scroll-margin-top: 72px;
    }
  }
  /* The section heading is the small eyebrow; the Intro headline under it is the big line. */
  .case-body :global(h2) {
    margin: 0 0 -8px;
    font-size: 13px;
    line-height: 1.4;
    font-weight: 600;
    color: var(--accent-strong);
  }
  /* With a visual and room for it: eyebrow, headline and lede left, the visual right. */
  @container case (min-width: 820px) {
    .case-body :global(.cs-section:has(> .intro--split)) {
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
      column-gap: clamp(24px, 4vw, 56px);
      align-items: center;
    }
    .case-body :global(.cs-section:has(> .intro--split) > h2) {
      grid-column: 1;
      align-self: end;
    }
    .case-body :global(.intro--split) {
      display: contents;
    }
    .case-body :global(.intro--split > .intro-head) {
      grid-column: 1;
      align-self: start;
    }
    .case-body :global(.intro--split > .intro-visual) {
      grid-column: 2;
      grid-row: 1 / span 2;
    }
  }
  /* Plain markdown prose: only direct children of a section, so components keep their own styles. */
  .case-body :global(.cs-section > h3) {
    margin: 12px 0 0;
    font-size: 20px;
    line-height: 1.3;
    letter-spacing: -0.01em;
    font-weight: 600;
  }
  .case-body :global(.cs-section > p),
  .case-body :global(.cs-section > ul > li),
  .case-body :global(.cs-section > ol > li) {
    margin: 0;
    font-size: 17px;
    line-height: 1.7;
    color: var(--ink);
  }
  .case-body :global(.cs-section > ul),
  .case-body :global(.cs-section > ol) {
    margin: 0;
    padding-inline-start: 1.25em;
    display: grid;
    gap: 10px;
  }
  .case-body :global(.cs-section > ul) {
    list-style: disc;
  }
  .case-body :global(.cs-section > ol) {
    list-style: decimal;
  }
  .case-body :global(.cs-section > * > li::marker) {
    color: var(--muted);
  }
  .case-body :global(.cs-section > * strong) {
    font-weight: 600;
  }
  .case-body :global(.cs-section > * a:not(.ext)) {
    color: var(--accent-strong);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  /* External link component is a pill button: no underline, its own colors. */
  .case-body :global(a.ext) {
    justify-self: start;
  }
  .placeholder-tag {
    display: inline-block;
    margin-inline-end: 6px;
    padding: 2px 8px;
    border: 1px dashed var(--muted);
    border-radius: var(--radius-pill);
    font-size: 12px;
    font-weight: 600;
    color: var(--muted);
    vertical-align: 2px;
  }

  .next-link {
    transition:
      transform 0.35s cubic-bezier(0.2, 0.8, 0.2, 1),
      box-shadow 0.35s;
  }
  .next-link:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow);
  }
  .more i {
    transition: transform 0.3s;
  }
  .next-link:hover .more i {
    transform: translateX(4px);
  }
</style>
