---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found" description="This page doesn't exist.">
  <div class="mx-auto max-w-content px-[clamp(16px,5vw,56px)] pt-[clamp(48px,10vw,120px)] pb-8">
    <div class="lost grid gap-4 md:grid-cols-[minmax(0,1fr)_minmax(0,1.1fr)] md:items-center">
      <div class="code" aria-hidden="true">
        <span>4</span><span class="ring"></span><span>4</span>
      </div>
      <div class="grid gap-2 max-w-[48ch]">
        <p class="m-0 text-[14px] font-medium text-muted">Error 404 · Page not found</p>
        <h1 class="m-0 text-[clamp(30px,4.4vw,48px)] leading-[1.12] tracking-[-0.025em] font-semibold text-balance">
          I spent nine years noticing what breaks <em class="not-italic text-accent">before it breaks</em>. This one got past me.
        </h1>
        <p class="m-0 text-[17px] leading-[1.6] text-muted">
          The link may be old, or the page may have moved. Here is where you can go from here.
        </p>
        <div class="flex flex-wrap gap-[10px] pt-1">
          <a class="inline-flex items-center min-h-[44px] px-[18px] rounded-pill bg-accent text-on-accent text-[15px] font-medium no-underline hover:bg-accent-strong transition-colors" href="/#work">See the work</a>
          <a class="inline-flex items-center min-h-[44px] px-[18px] rounded-pill border border-line text-ink text-[15px] font-medium no-underline hover:bg-surface transition-colors" href="/">Go home</a>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .code {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(8px, 2vw, 20px);
    padding: clamp(24px, 5vw, 56px);
    border: 1px solid var(--line);
    border-radius: var(--radius-card);
    background: var(--surface);
    font-size: clamp(88px, 16vw, 180px);
    font-weight: 700;
    letter-spacing: -0.06em;
    line-height: 1;
    color: var(--ink);
  }
  /* The zero is an empty observation ring with a scanning dot: something should be here. */
  .ring {
    position: relative;
    width: 0.62em;
    height: 0.8em;
    border: 0.09em solid var(--accent);
    border-radius: 999px;
  }
  .ring::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 50%;
    width: 0.1em;
    height: 0.1em;
    margin: -0.05em 0 0 -0.05em;
    border-radius: 50%;
    background: var(--accent-strong);
  }
  @media (prefers-reduced-motion: no-preference) {
    .ring::after {
      animation: search 3.2s ease-in-out infinite;
    }
    @keyframes search {
      0%, 100% { transform: translate(-0.12em, -0.18em); }
      33% { transform: translate(0.12em, 0); }
      66% { transform: translate(-0.08em, 0.2em); }
    }
  }
</style>
