---
/**
 * A home-page project card: the product on top, then title, tagline, tags and
 * "View case study". The title is the link, stretched over the whole card (::after), so the
 * card clicks anywhere while its recordings keep real pause / play buttons (VideoToggle,
 * never nested in a link), raised above the stretch.
 *
 * A desktop project with a flow recording (src/assets/work/<slug>/flow.mp4) shows it in
 * a browser window, large. A mobile project with `cardPhones` shows those recordings in two
 * phones, and a `cardPhoto` (a real photo, tilted) beside them. Every other project shows
 * its hero stage.
 *
 * A `comingSoon` project is a calm card that links nowhere: its stage (a mobile project: the
 * coming-soon phone), title, tagline, tags and a "Case study coming soon" label. A desktop one
 * is a slim full-width row, stage beside the text, so it never reads as an empty slab.
 * Role, duration, status and tools are not shown here; they live on the case-study page.
 */
import type { CollectionEntry } from 'astro:content';
import Stage from './Stage.astro';
import BrowserFrame from './BrowserFrame.astro';
import Phone from './Phone.astro';
import ComingSoonPhone from './ComingSoonPhone.astro';
import Photo from './Photo.astro';
import { flowMedia, workClip } from '../lib/stage-media';

interface Props {
  entry: CollectionEntry<'work'>;
}
const { entry } = Astro.props;
const { title, tagline, platform, tags, stageAlt, phones, cardPhones, comingSoon, nativeScreen, cardPhoto } = entry.data;
const titleId = `card-${entry.id}`;
const flow = platform === 'desktop' ? flowMedia(entry.id) : null;
const cardPhoneMedia = (cardPhones ?? []).flatMap((clip) => {
  const phone = phones?.find((p) => p.clip === clip);
  const media = workClip(entry.id, clip);
  return phone && media ? [{ ...phone, media }] : [];
});
---

<article
  aria-labelledby={titleId}
  class:list={[
    'card group grid overflow-hidden rounded-card border border-line bg-surface text-inherit no-underline',
    platform === 'desktop' && 'md:col-span-2',
    (flow || cardPhoneMedia.length > 0 || comingSoon) && 'card--device',
    comingSoon && 'card--soon',
    comingSoon && platform === 'desktop' && 'card--soon-row',
  ]}
>
  {
    flow && !comingSoon ? (
      <div class="browser-stage">
        <BrowserFrame media={flow} label={stageAlt ?? `${title}: a recording of the product in use.`} pausable />
      </div>
    ) : comingSoon && platform === 'mobile' ? (
      <div class="soon-stage">
        <ComingSoonPhone title={title} />
      </div>
    ) : cardPhoneMedia.length > 0 ? (
      <div class:list={['phones-stage', cardPhoto && 'phones-stage--photo']}>
        {cardPhoneMedia.map((p) => (
          <Phone media={p.media} label={p.alt} native={nativeScreen} />
        ))}
        {cardPhoto && <Photo project={entry.id} name={cardPhoto.image} alt={cardPhoto.alt} class="card-photo" sizes="(min-width: 760px) 260px, 42vw" />}
      </div>
    ) : (
      <Stage slug={entry.id} title={title} platform={platform} alt={stageAlt} />
    )
  }
  <div class="info">
    <div class="grid gap-[10px] min-w-0 max-w-[560px]">
      <h3 id={titleId} class="m-0 text-[clamp(24px,3vw,28px)] font-semibold tracking-[-0.01em]">
        {comingSoon ? title : <a class="card-link" href={`/work/${entry.id}`}>{title}</a>}
      </h3>
      <p class="m-0 text-[16px] leading-relaxed text-muted">{tagline}</p>
      <ul role="list" aria-label="Tags" class="m-0 p-0 list-none flex flex-wrap gap-1">
        {tags.map((tag) => <li class="text-[13px] border border-line rounded-pill px-[12px] py-[5px] bg-raise">{tag}</li>)}
      </ul>
    </div>
    {
      comingSoon ? (
        <p class="soon-label m-0 text-[13px] font-semibold text-muted border border-dashed border-muted rounded-pill px-[12px] py-[5px] whitespace-nowrap">
          Case study coming soon
        </p>
      ) : (
        <span class="more inline-flex items-center gap-[6px] text-[15px] font-semibold text-accent-strong whitespace-nowrap">
          View case study <i class="not-italic" aria-hidden="true">→</i>
        </span>
      )
    }
  </div>
</article>

<style>
  .card {
    position: relative;
    transition:
      transform 0.35s cubic-bezier(0.2, 0.8, 0.2, 1),
      box-shadow 0.35s;
  }
  /* The title link covers the card; the focus ring goes around the whole card. */
  .card-link {
    color: inherit;
    text-decoration: none;
  }
  .card-link::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    border-radius: inherit;
  }
  .card-link:focus-visible {
    outline: none;
  }
  .card:has(.card-link:focus-visible) {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }
  /* Pause / play stays clickable above the stretched link: the recordings sit above it (some
     are transformed, which makes their own layer) but let clicks fall through to it, except
     on their buttons. */
  .card :global(.phone),
  .card :global(.browser) {
    position: relative;
    z-index: 2;
    pointer-events: none;
  }
  .card :global(.vtoggle) {
    pointer-events: auto;
  }
  .card:has(.card-link:hover) {
    transform: translateY(-3px);
    box-shadow: var(--shadow);
  }
  .card--device {
    background: radial-gradient(120% 90% at 80% 0%, var(--accent-tint) 0%, var(--surface) 55%);
  }
  .browser-stage {
    padding: clamp(28px, 5vw, 56px) clamp(18px, 5vw, 64px) clamp(36px, 5vw, 56px);
  }
  .phones-stage {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(14px, 3vw, 36px);
    align-items: end;
    width: 100%;
    max-width: 520px;
    margin-inline: auto;
    padding: clamp(28px, 5vw, 48px) clamp(18px, 5vw, 48px) clamp(36px, 5vw, 48px);
  }
  /* The second phone sits a little higher, as in the concept. */
  .phones-stage > :global(.phone:last-child) {
    transform: translateY(-28px);
  }
  /* A phone next to a real photo: the photo a little higher and tilted, as in the concept. */
  .phones-stage--photo {
    max-width: 620px;
    gap: clamp(16px, 4vw, 48px);
    align-items: center;
  }
  .phones-stage--photo > :global(.card-photo) {
    transform: translateY(-20px) rotate(2deg);
  }
  .soon-stage {
    display: grid;
    justify-items: center;
    padding: clamp(28px, 5vw, 48px) clamp(18px, 5vw, 48px) clamp(20px, 3vw, 28px);
  }
  .soon-stage :global(.phone) {
    max-width: 200px;
  }
  .info {
    display: flex;
    flex-wrap: wrap;
    gap: 16px 32px;
    align-items: end;
    justify-content: space-between;
    padding: clamp(18px, 3vw, 30px);
  }
  .card--device .info {
    padding: 0 clamp(20px, 4vw, 40px) clamp(22px, 3vw, 32px);
  }
  /* Coming soon, desktop: a slim row from 760px, the stage beside the text. */
  @media (min-width: 47.5rem) {
    .card--soon-row {
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
      align-items: center;
    }
    .card--soon-row .info {
      flex-direction: column;
      align-items: start;
      justify-content: center;
      padding: clamp(22px, 3vw, 32px) clamp(20px, 4vw, 40px);
    }
  }
  /* The stage fills its column; the row, not the stage's aspect ratio, sets the height. */
  @media (min-width: 47.5rem) {
    .card--soon-row :global(.stage) {
      aspect-ratio: auto;
      width: 100%;
      height: 100%;
      min-height: 300px;
    }
  }
  .more i {
    transition: transform 0.3s;
  }
  .card:has(.card-link:hover) .more i {
    transform: translateX(4px);
  }
</style>
