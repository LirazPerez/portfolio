---
/**
 * A screen recording: muted, looping, inline, no native controls, hidden from assistive
 * tech (the text alternative lives on the stage, browser window or frame around it). It is not set
 * to autoplay in markup and preloads nothing, so it costs only its poster until it nears the
 * screen; the script below plays it only when motion is allowed and it is on screen. With no
 * JS or under prefers-reduced-motion the poster shows.
 *
 * Give it an `id` and place a <VideoToggle for={id} /> next to it (outside any role="img"
 * wrapper) for a pause / play control. A recording the viewer paused stays paused; under
 * reduced motion the same control lets them play it on purpose.
 */
import type { StageVideoSource } from '../lib/stage-media';
import type { ImageMetadata } from 'astro';

interface Props {
  sources: StageVideoSource[];
  poster?: ImageMetadata;
  /** Which part of the recording stays in view when the frame crops it. */
  position?: 'top' | 'top-left' | 'center';
  id?: string;
}
const { sources, poster, position = 'top', id } = Astro.props;
---

<video
  id={id}
  class:list={['stage-video', position === 'top-left' && 'stage-video--top-left', position === 'center' && 'stage-video--center']}
  data-stage-video
  muted
  loop
  playsinline
  preload="none"
  poster={poster?.src}
  aria-hidden="true"
  tabindex="-1"
  disablepictureinpicture
  disableRemotePlayback
>
  {sources.map((s) => <source src={s.src} type={s.type} />)}
</video>

<style>
  .stage-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Keep the top of the app (its title) in view; the empty bottom is what gets cropped. */
    object-position: top center;
    display: block;
  }
  .stage-video--top-left {
    object-position: top left;
  }
  .stage-video--center {
    object-position: center;
  }
</style>

<script>
  // Recordings play only when motion is allowed, only while on screen, and never after the
  // viewer paused them. Toggle buttons ([data-video-toggle="<video id>"]) pause and play.
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
  const videos = document.querySelectorAll<HTMLVideoElement>('video[data-stage-video]');
  const visible = new WeakSet<HTMLVideoElement>();

  const toggles = (video: HTMLVideoElement) =>
    video.id ? document.querySelectorAll<HTMLButtonElement>(`[data-video-toggle="${video.id}"]`) : [];

  function sync(video: HTMLVideoElement) {
    const playing = !video.paused;
    for (const btn of toggles(video)) {
      btn.dataset.state = playing ? 'playing' : 'paused';
      btn.setAttribute('aria-label', playing ? 'Pause the recording' : 'Play the recording');
    }
  }

  // Autoplay wants: on screen, motion allowed, not paused by the viewer (or started on purpose).
  function update(video: HTMLVideoElement) {
    const chosen = video.dataset.viewer;
    const want = visible.has(video) && (chosen === 'play' || (chosen !== 'pause' && !reduce.matches));
    if (want && video.paused) void video.play().catch(() => {});
    else if (!want && !video.paused) video.pause();
  }

  if (videos.length) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          const video = entry.target as HTMLVideoElement;
          if (entry.isIntersecting) visible.add(video);
          else visible.delete(video);
          update(video);
        }
      },
      { threshold: 0.25 },
    );
    videos.forEach((video) => {
      io.observe(video);
      video.addEventListener('play', () => sync(video));
      video.addEventListener('pause', () => sync(video));
      sync(video);
      for (const btn of toggles(video)) {
        btn.hidden = false;
        btn.addEventListener('click', () => {
          video.dataset.viewer = video.paused ? 'play' : 'pause';
          if (video.dataset.viewer === 'play') void video.play().catch(() => {});
          else video.pause();
        });
      }
    });
    reduce.addEventListener('change', () => videos.forEach(update));
  }
</script>
