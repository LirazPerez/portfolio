---
/**
 * A stage screen recording: muted, looping, inline, no controls, hidden from assistive
 * tech (the text alternative lives on the stage). It is not set to autoplay in markup;
 * the script in Stage.astro plays it only when motion is allowed and it is on screen,
 * so it shows its poster with no JS and under prefers-reduced-motion.
 */
import type { StageVideoSource } from '../lib/stage-media';
import type { ImageMetadata } from 'astro';

interface Props {
  sources: StageVideoSource[];
  poster?: ImageMetadata;
}
const { sources, poster } = Astro.props;
---

<video
  class="stage-video"
  data-stage-video
  muted
  loop
  playsinline
  preload="metadata"
  poster={poster?.src}
  aria-hidden="true"
  tabindex="-1"
  disablepictureinpicture
  disableRemotePlayback
>
  {sources.map((s) => <source src={s.src} type={s.type} />)}
</video>

<style>
  .stage-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
</style>
