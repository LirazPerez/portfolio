---
/**
 * Waypoint's earlier hero stage scene, kept as the fallback for when the stage recording
 * is missing: the caregiver's home in one window, Ilan's medications appearing one after
 * another, each with its status in words.
 *
 * Pure CSS, looping, 7s. It starts mid-cycle (negative animation delay) so the very
 * first frame is the complete scene, and with prefers-reduced-motion nothing animates and
 * the un-animated style IS that complete frame (everything in place).
 *
 * Colors come only from --waypoint-* custom properties, defined in Stage.astro and
 * scoped to this project's stage. They never leak into site chrome.
 *
 * `backdrop` is the built-in scene behind the UI (a blurred airport glass wall). It is
 * what Waypoint shows until a real photo is dropped in src/assets/stages/, which then
 * takes its place.
 */
interface Props {
  backdrop?: boolean;
}
const { backdrop = true } = Astro.props;

---

{
  backdrop && (
    <div class="wp-backdrop" aria-hidden="true">
      <svg viewBox="0 0 800 410" preserveAspectRatio="xMidYMid slice" focusable="false">
        <rect x="0" y="300" width="800" height="110" fill="var(--waypoint-scene-floor)" />
        <g fill="var(--waypoint-scene-mullion)">
          <rect x="0" y="40" width="800" height="10" />
          <rect x="0" y="292" width="800" height="12" />
          <rect x="96" y="40" width="8" height="260" />
          <rect x="246" y="40" width="8" height="260" />
          <rect x="396" y="40" width="8" height="260" />
          <rect x="546" y="40" width="8" height="260" />
          <rect x="696" y="40" width="8" height="260" />
          <rect x="0" y="170" width="800" height="4" />
          <path d="M470 236 l120 -10 l30 -18 l12 2 l-10 22 l60 -4 l6 6 l-62 10 l8 10 l-10 2 l-18 -9 l-118 10 z" />
          <rect x="40" y="318" width="190" height="34" rx="6" />
          <rect x="300" y="318" width="190" height="34" rx="6" />
          <rect x="560" y="318" width="190" height="34" rx="6" />
        </g>
      </svg>
    </div>
  )
}

<div class="wp-scene" aria-hidden="true">
  <div class="wp-desk">
    <div class="wp-desk-bar"><i></i><i></i><i></i></div>
    <div class="wp-pv">
      <div class="wp-pv-head"><strong>Good morning, Dana</strong><small>Ilan · week 12</small></div>
      <div class="wp-row wp-stagger" style="--d:0s"><span>Gabapentin 300 mg</span><span class="wp-check">Check</span></div>
      <div class="wp-row wp-stagger" style="--d:.25s"><span>Levothyroxine 75 mcg</span><span class="wp-pill">Confirmed</span></div>
      <div class="wp-row wp-stagger" style="--d:.45s"><span>Omeprazole 20 mg</span><span class="wp-check">Check</span></div>
      <div class="wp-row wp-stagger" style="--d:.65s"><span>Prescription renewal</span><span class="wp-pill">Hebrew · translated</span></div>
    </div>
  </div>
</div>

<style>
  .wp-backdrop {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--waypoint-scene-sky);
    overflow: hidden;
  }
  .wp-backdrop svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    filter: blur(7px);
    transform: scale(1.06);
  }
  .wp-backdrop::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 40%, color-mix(in srgb, var(--waypoint-flat) 55%, transparent) 100%);
  }

  .wp-scene {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(14px, 4vw, 44px);
    width: 100%;
    min-width: 0;
  }

  .wp-desk {
    flex: 1 1 auto;
    max-width: 470px;
    min-width: 0;
    background: var(--waypoint-surface);
    border: 1px solid var(--waypoint-border);
    border-radius: 10px;
    box-shadow: 0 26px 50px -24px rgb(0 0 0 / 0.6);
    overflow: hidden;
    color: var(--waypoint-ink);
  }
  .wp-desk-bar {
    display: flex;
    gap: 5px;
    padding: 8px 10px;
    border-bottom: 1px solid var(--waypoint-border);
    background: var(--waypoint-paper);
  }
  .wp-desk-bar i {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--waypoint-border);
    display: block;
  }
  .wp-pv {
    padding: clamp(10px, 1.6vw, 16px);
    display: grid;
    gap: 10px;
    font-size: clamp(9.5px, 1.15vw, 12.5px);
  }
  .wp-pv-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 8px;
    flex-wrap: wrap;
  }
  .wp-pv-head strong {
    font-size: 1.15em;
  }
  .wp-pv-head small {
    color: var(--waypoint-muted);
  }
  .wp-row {
    display: flex;
    justify-content: space-between;
    gap: 10px;
    border-bottom: 1px solid var(--waypoint-border);
    padding-bottom: 6px;
  }
  .wp-row span:last-child {
    color: var(--waypoint-muted);
    text-align: end;
  }
  .wp-row .wp-check {
    color: var(--waypoint-critical);
    font-weight: 600;
  }
  .wp-row .wp-pill {
    color: var(--waypoint-route);
    font-weight: 600;
  }

  /* Motion only when allowed. Each animation starts 4.5s into its 7s cycle, so the first
     frame already shows the complete scene (desk risen, rows in). */
  @media (prefers-reduced-motion: no-preference) {
    .wp-desk {
      animation: wp-rise 7s cubic-bezier(0.2, 0.8, 0.2, 1) infinite;
      animation-delay: -4.5s;
    }
    .wp-stagger {
      animation: wp-appear 7s ease-out infinite;
      animation-delay: calc(-4.5s + var(--d, 0s));
    }
  }
  /* With JS, the loop is held at its complete first frame until the stage is on screen
     (the script below sets data-scene-playing), so a visitor who scrolls down later
     still meets the complete scene first, and nothing animates off-screen. Without JS
     the loop simply runs. */
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .wp-desk,
    :global(.js) .wp-stagger {
      animation-play-state: paused;
    }
    :global(.js) .wp-scene[data-scene-playing] .wp-desk,
    :global(.js) .wp-scene[data-scene-playing] .wp-stagger {
      animation-play-state: running;
    }
  }
  @keyframes wp-rise {
    0%, 22% { transform: translateY(10px); opacity: 0.55; }
    32%, 92% { transform: none; opacity: 1; }
    100% { transform: translateY(10px); opacity: 0.55; }
  }
  @keyframes wp-appear {
    0%, 26% { opacity: 0.15; transform: translateY(4px); }
    36%, 92% { opacity: 1; transform: none; }
    100% { opacity: 0.15; transform: translateY(4px); }
  }
</style>

<script>
  const scenes = document.querySelectorAll<HTMLElement>('.wp-scene');
  if (scenes.length) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          (entry.target as HTMLElement).toggleAttribute('data-scene-playing', entry.isIntersecting);
        }
      },
      { threshold: 0.2 },
    );
    scenes.forEach((scene) => io.observe(scene));
  }
</script>
