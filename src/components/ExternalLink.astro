---
/**
 * A link to an external site: opens in a new tab, shows an icon, and says so in its
 * accessible name. The visible label is the slot.
 * `primary` is the filled accent button (e.g. "Try the live app"); the default is a quiet pill.
 * `icon="arrow"` draws a plain arrow instead of the new-tab icon (the accessible name still
 * says it opens in a new tab).
 */
interface Props {
  href: string;
  variant?: 'default' | 'primary';
  icon?: 'external' | 'arrow';
}
const { href, variant = 'default', icon = 'external' } = Astro.props;
---

<a
  class:list={[
    'ext inline-flex items-center gap-[8px] min-h-[44px] px-[18px] rounded-pill text-[15px] no-underline transition-colors',
    variant === 'primary'
      ? 'ext--primary bg-accent text-on-accent font-semibold hover:bg-accent-strong'
      : 'border border-line bg-raise text-ink font-medium hover:bg-surface',
  ]}
  href={href}
  target="_blank"
  rel="noopener noreferrer"
>
  <span><slot /></span>
  <span class="sr-only-text">(opens an external site in a new tab)</span>
  {icon === 'arrow' ? (
    <span class="ext-arrow" aria-hidden="true">→</span>
  ) : (
  <svg
    width="15"
    height="15"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
    focusable="false"
  >
    <path d="M14 4h6v6"></path>
    <path d="M20 4l-9 9"></path>
    <path d="M18 14v4a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4"></path>
  </svg>
  )}
</a>

<style>
  .ext-arrow {
    transition: transform 0.25s;
  }
  .ext:hover .ext-arrow {
    transform: translateX(3px);
  }
</style>
