---
// Light/dark toggle. The first paint is handled by the inline script in BaseLayout;
// this only flips and persists the choice. Hidden when JS is off (it would do nothing).
---

<button class="theme-btn" type="button" data-theme-toggle aria-label="Switch to dark mode">
  <svg
    class="icon-moon"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.8"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
    focusable="false"
  >
    <path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z"></path>
  </svg>
  <svg
    class="icon-sun"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.8"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
    focusable="false"
  >
    <circle cx="12" cy="12" r="4"></circle>
    <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
  </svg>
</button>

<script>
  const KEY = 'lh-theme';
  const root = document.documentElement;
  const mq = window.matchMedia('(prefers-color-scheme: dark)');
  const btn = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');

  const effective = () => {
    const t = root.getAttribute('data-theme');
    return t === 'light' || t === 'dark' ? t : mq.matches ? 'dark' : 'light';
  };
  const sync = () =>
    btn?.setAttribute('aria-label', effective() === 'dark' ? 'Switch to light mode' : 'Switch to dark mode');

  btn?.addEventListener('click', () => {
    const next = effective() === 'dark' ? 'light' : 'dark';
    root.setAttribute('data-theme', next);
    try {
      localStorage.setItem(KEY, next);
    } catch {}
    sync();
  });
  mq.addEventListener('change', sync);
  sync();
</script>

<style>
  .theme-btn {
    display: none;
    flex: none;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: var(--ink);
    cursor: pointer;
    transition:
      background 0.2s,
      transform 0.3s;
  }
  :global(.js) .theme-btn {
    display: grid;
  }
  .theme-btn:hover {
    background: var(--accent-tint);
  }
  .theme-btn:active {
    transform: rotate(-20deg) scale(0.92);
  }
  svg {
    width: 18px;
    height: 18px;
    grid-area: 1 / 1;
  }

  /* Show the icon of the theme you would switch TO. Same selectors as the tokens. */
  .icon-sun {
    display: none;
  }
  :global(:root[data-theme='dark']) .icon-sun {
    display: block;
  }
  :global(:root[data-theme='dark']) .icon-moon {
    display: none;
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .icon-sun {
      display: block;
    }
    :global(:root:not([data-theme='light'])) .icon-moon {
      display: none;
    }
  }
</style>
