---
import { CV_HREF, CV_SIZE_LABEL } from '../lib/cv';
import ThemeToggle from './ThemeToggle.astro';

type Key = 'work' | 'about' | 'cv' | 'contact';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const active: Key | null =
  path === '' || path === '/' || path.startsWith('/work') ? 'work' : path === '/about' ? 'about' : null;
// "page" when the link is this exact page; "true" when we are inside its area (a case study under Work).
const current = (key: Key) =>
  key !== active ? undefined : key === 'work' && path.startsWith('/work') ? 'true' : 'page';

const items: { key: Key; label: string; href: string }[] = [
  { key: 'work', label: 'Work', href: '/#work' },
  { key: 'about', label: 'About', href: '/about' },
  { key: 'cv', label: 'CV', href: CV_HREF },
  { key: 'contact', label: 'Contact', href: '#contact' },
];
---

<header class="navbar">
  <a class="home" href="/" aria-label="Liraz Hazala Perez, home">
    <span class="sig" aria-hidden="true">
      <span class="s1">Liraz</span>
      <span class="s2">Perez</span>
      <svg class="sig-link" aria-hidden="true" focusable="false"><path data-sig-path d=""></path></svg>
    </span>
  </a>

  <nav class="capsule" aria-label="Site">
    <ul class="links" role="list">
      {
        items.map((item) => (
          <li>
            <a href={item.href} aria-current={current(item.key)} class:list={[item.key === 'cv' && 'cv-link']}>
              {item.key === active && <span class="pill" aria-hidden="true" />}
              <span class="label">{item.label}</span>
              {item.key === 'cv' && (
                <>
                  <svg
                    class="cv-icon"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                    focusable="false"
                  >
                    <path d="M12 4v11M7 10l5 5 5-5M5 20h14" />
                  </svg>
                  <span class="sr-only-text">, PDF download, {CV_SIZE_LABEL}</span>
                </>
              )}
            </a>
          </li>
        ))
      }
    </ul>
    <span class="sep" aria-hidden="true"></span>
    <ThemeToggle />
  </nav>
</header>

<script>
  // Signature joining stroke: from the tail of the "z" in "Liraz" into the top of the "P" in "Perez".
  // Measured from the real glyph boxes once Caveat has loaded (same geometry as reference/specimen.html,
  // but using layout offsets so the -4deg rotation isn't counted twice).
  function joinSignature() {
    const sig = document.querySelector<HTMLElement>('.navbar .sig');
    const path = sig?.querySelector('[data-sig-path]');
    const a = sig?.querySelector<HTMLElement>('.s1');
    const b = sig?.querySelector<HTMLElement>('.s2');
    if (!sig || !path || !a || !b) return;
    const fs = parseFloat(getComputedStyle(sig).fontSize);
    const x1 = a.offsetLeft + a.offsetWidth - fs * 0.07;
    const y1 = a.offsetTop + a.offsetHeight - fs * 0.26;
    const x2 = b.offsetLeft + fs * 0.16;
    const y2 = b.offsetTop + fs * 0.3;
    path.setAttribute(
      'd',
      `M${x1} ${y1} C ${x1 + fs * 0.18} ${y1 + fs * 0.32}, ${x2 + fs * 0.55} ${y2 - fs * 0.42}, ${x2} ${y2}`,
    );
  }
  if (document.fonts?.load) {
    document.fonts.load('600 27px Caveat').then(joinSignature, joinSignature);
  } else {
    joinSignature();
  }
</script>

<style>
  .navbar {
    position: sticky;
    top: env(safe-area-inset-top, 0px);
    z-index: 40;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 12px;
    padding: 16px clamp(16px, 5vw, 56px) 0;
    pointer-events: none;
  }
  .navbar > * {
    pointer-events: auto;
  }

  /* ---------- Signature wordmark (the one Caveat exception) ---------- */
  .home {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    min-width: 44px;
    padding: 6px 8px 10px 4px;
    color: var(--ink);
    text-decoration: none;
    border-radius: var(--radius-control);
    transition: color 0.2s;
  }
  .home:hover {
    color: var(--accent-strong);
  }
  .sig {
    position: relative;
    display: inline-flex;
    flex-direction: column;
    align-items: flex-start;
    font-family: var(--font-signature);
    font-weight: 600;
    font-size: 27px;
    line-height: 0.78;
    white-space: nowrap;
    transform: rotate(-4deg);
    transform-origin: left center;
  }
  .s2 {
    margin-left: 0.5em;
    margin-top: -0.02em;
  }
  .sig-link {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
  }
  .sig-link path {
    fill: none;
    stroke: currentColor;
    stroke-width: 0.075em;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* ---------- Capsule ---------- */
  .capsule {
    display: flex;
    align-items: center;
    gap: 4px;
    max-width: 100%;
    padding: 5px;
    border-radius: var(--radius-pill);
    background: var(--glass);
    border: 1px solid var(--line);
    box-shadow: var(--shadow);
    -webkit-backdrop-filter: saturate(160%) blur(16px);
    backdrop-filter: saturate(160%) blur(16px);
  }
  .links {
    display: flex;
    gap: 2px;
    margin: 0;
    padding: 0;
    list-style: none;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .links::-webkit-scrollbar {
    display: none;
  }
  .links a {
    position: relative;
    isolation: isolate;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 14px;
    border-radius: var(--radius-pill);
    color: var(--muted);
    font-size: 15px;
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
    transition: color 0.2s;
  }
  .links a:hover {
    color: var(--ink);
  }
  .links a[aria-current] {
    color: var(--accent-strong);
  }
  /* The active pill. Its view-transition-name lets the browser slide it to the new item between pages. */
  .pill {
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: inherit;
    background: var(--accent-tint);
    view-transition-name: nav-pill;
  }
  .cv-icon {
    width: 15px;
    height: 15px;
    margin-inline-start: 6px;
    transition: transform 0.3s cubic-bezier(0.3, 1.6, 0.5, 1);
  }
  .cv-link:hover .cv-icon,
  .cv-link:focus-visible .cv-icon {
    transform: translateY(2px);
  }
  .sep {
    flex: none;
    width: 1px;
    height: 20px;
    margin-inline: 2px;
    background: var(--line);
  }

  /* ---------- Under 760px: the capsule docks to the bottom as a tab bar ---------- */
  @media (max-width: 47.49rem) {
    .navbar {
      position: relative;
      grid-template-columns: 1fr;
    }
    .capsule {
      position: fixed;
      left: 50%;
      bottom: calc(12px + env(safe-area-inset-bottom, 0px));
      transform: translateX(-50%);
      max-width: calc(100vw - 24px);
      z-index: 50;
    }
    .links a {
      padding: 0 10px;
      font-size: 14px;
    }
  }
  @media (max-width: 360px) {
    .links a {
      padding: 0 8px;
    }
  }
</style>
