---
/** Two screens side by side from 760px up, stacked below. Put two <Screen /> inside. */
---

<div class="pair"><slot /></div>

<style>
  .pair {
    display: grid;
    gap: 16px;
    width: 100%;
  }
  @media (min-width: 47.5rem) {
    /* Each screen takes a share of the row proportional to its own aspect ratio (--ar,
       set by <Screen />), so both come out the same height and the same scale. Equal
       columns would shrink a wide crop to half size beside a narrow one. */
    .pair {
      display: flex;
      align-items: flex-start;
      width: calc(100% + 48px);
      margin-inline: -24px;
    }
    .pair :global(.screen) {
      flex: var(--ar) 1 0;
      min-width: 0;
      width: auto;
      margin-inline: 0;
    }
  }
</style>
