---
/**
 * A generic laptop: dark bezel, a 16:10 screen and a thin base. No brand, no logo.
 * The screen plays a project's flow recording (object-fit: cover, anchored top-left, so
 * the app's sidebar and page title always stay in view). The whole laptop is one image to
 * assistive tech; the video itself is aria-hidden.
 *
 * Motion: the recording only plays when motion is allowed and the laptop is on screen
 * (StageVideo). With reduced motion or no JS the poster (the recording's first frame) shows.
 * All colors are tokens (--bezel, --bezel-edge, --deck, --deck-edge, --deck-shadow).
 */
import StageVideo from './StageVideo.astro';
import type { FlowMedia } from '../lib/stage-media';

interface Props {
  media: FlowMedia;
  /** Text alternative: what the recording shows, start to end. */
  label: string;
  class?: string;
}
const { media, label, class: className } = Astro.props;
---

<div class:list={['laptop', className]} role="img" aria-label={label}>
  <div class="lid">
    <div class="screen">
      <StageVideo sources={media.videos} poster={media.poster} position="top-left" />
    </div>
  </div>
  <div class="deck" aria-hidden="true"></div>
</div>

<style>
  .laptop {
    position: relative;
    width: 100%;
    max-width: 860px;
    margin-inline: auto;
  }
  .lid {
    position: relative;
    padding: 2.2% 2.2% 3%;
    border-radius: 18px 18px 6px 6px;
    background: var(--bezel);
    box-shadow:
      inset 0 0 0 1px var(--bezel-edge),
      var(--shadow-lift);
  }
  /* The camera. */
  .lid::before {
    content: '';
    position: absolute;
    top: 1%;
    left: 50%;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--bezel-edge);
    transform: translateX(-50%);
  }
  .screen {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border-radius: 4px;
    background: var(--surface);
  }
  .deck {
    position: relative;
    height: 14px;
    margin: 0 -5%;
    border-radius: 2px 2px 14px 14px;
    background: linear-gradient(var(--deck), var(--deck-edge));
    box-shadow: 0 18px 30px -14px var(--deck-shadow);
  }
  /* The notch where the lid opens. */
  .deck::after {
    content: '';
    position: absolute;
    top: 0;
    left: 50%;
    width: 16%;
    height: 5px;
    border-radius: 0 0 8px 8px;
    background: var(--deck-edge);
    transform: translateX(-50%);
  }
  @media (max-width: 47.49rem) {
    .lid {
      border-radius: 12px 12px 4px 4px;
    }
    .deck {
      height: 9px;
      border-radius: 2px 2px 10px 10px;
    }
  }
</style>
