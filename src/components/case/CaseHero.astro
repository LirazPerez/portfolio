---
/**
 * The top of every case study: eyebrow, title, tagline, one meta row (role, time, tools,
 * status), the product, and the origin line.
 *
 * The product is a browser window with the project's flow recording when it has one (desktop
 * projects), standing alone; otherwise the hero stage.
 *
 * `origin` (where the project comes from, what is and is not shown) is a small note right
 * under the meta row, so it is read together with the status.
 *
 * A mobile project with `phones` shows its recordings in up to three phones instead, the
 * middle one larger, each with a short caption. Below 760px the third one is left out
 * (the flows section further down shows all three).
 * A `heroPhoto` (a real photo, e.g. the Watch on my wrist) closes that row; then below 760px
 * the first phone is the one left out, so the photo stays.
 *
 * A `comingSoon` project shows only the title, tagline and its stage (a mobile one: the
 * coming-soon phone); the meta row and origin wait for the real case study. (`soon` is
 * decided by the template: a coming-soon project whose case study is written shows it all.)
 *
 * Optional, for any project: `demo` (a filled "Try the live demo" button under the meta row),
 * `highlights` (up to three summary bullets under it) and `heroNotes` (numbered notes under
 * the recording, saying what to notice in it).
 */
import type { CollectionEntry } from 'astro:content';
import BrowserFrame from '../BrowserFrame.astro';
import Stage from '../Stage.astro';
import Phone from '../Phone.astro';
import ComingSoonPhone from '../ComingSoonPhone.astro';
import Photo from '../Photo.astro';
import ExternalLink from '../ExternalLink.astro';
import { flowMedia, workClip } from '../../lib/stage-media';
import { STATUS_LABEL, PLATFORM_LABEL } from '../../lib/case-study';

interface Props {
  entry: CollectionEntry<'work'>;
  /** Show only the coming-soon hero. Defaults to the entry's `comingSoon`. */
  soon?: boolean;
}
const { entry } = Astro.props;
const comingSoon = Astro.props.soon ?? entry.data.comingSoon;
const { demo, highlights, heroNotes, title, tagline, lede, platform, role, duration, tools, status, statusLabel, origin, stageAlt, category, phones, nativeScreen, heroPhoto } =
  entry.data;
const phoneMedia = (phones ?? []).flatMap((p) => {
  const media = workClip(entry.id, p.clip);
  return media ? [{ ...p, media }] : [];
});

const flow = platform === 'desktop' ? flowMedia(entry.id) : null;
---

<header class="hero">
  <a href="/#work" class="back justify-self-start inline-flex items-center gap-1 min-h-[44px] text-[15px] text-muted hover:text-ink no-underline">
    <span aria-hidden="true">←</span> All work
  </a>
  <p class="eyebrow">Case study · {category ?? PLATFORM_LABEL[platform]}</p>
  <h1 id="cs-title">{title}</h1>
  <p class="lede">{lede ?? tagline}</p>
  {!comingSoon && (
  <dl class="meta">
    <div><dt>Role</dt><dd>{role}</dd></div>
    <div><dt>Time</dt><dd>{duration}</dd></div>
    <div><dt>Tools</dt><dd>{tools.join(' · ')}</dd></div>
    <div><dt>Status</dt><dd>{statusLabel ?? STATUS_LABEL[status]}</dd></div>
  </dl>
  )}
  {demo && !comingSoon && (
    <ExternalLink href={demo.href} variant="primary" icon="arrow">{demo.label}</ExternalLink>
  )}
  {highlights && !comingSoon && (
    <ul class="highlights" role="list">
      {highlights.map((h) => (
        <li>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 12.5l4.5 4.5L19 7.5"></path></svg>
          <span>{h}</span>
        </li>
      ))}
    </ul>
  )}
  {origin && !comingSoon && (
    <p class="origin">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="9"></circle><path d="M12 11v5M12 7.5v.01"></path></svg>
      <span>{origin}</span>
    </p>
  )}

  {
    comingSoon && platform === 'mobile' ? (
      <div class="soon-wrap">
        <ComingSoonPhone title={title} />
      </div>
    ) : phoneMedia.length > 0 ? (
      <ul class:list={['trio', heroPhoto && 'trio--photo']} role="list">
        {phoneMedia.map((p) => (
          <li>
            <Phone media={p.media} label={p.alt} native={nativeScreen} />
            <p class="trio-cap">
              <b>{p.title}</b> · {p.caption}
            </p>
          </li>
        ))}
        {heroPhoto && (
          <li>
            <Photo project={entry.id} name={heroPhoto.image} alt={heroPhoto.alt} class="trio-photo" loading="eager" sizes="(min-width: 760px) 260px, 45vw" />
            <p class="trio-cap">
              <b>{heroPhoto.title}</b> · {heroPhoto.caption}
            </p>
          </li>
        )}
      </ul>
    ) : flow ? (
      <div class="showcase">
        <BrowserFrame media={flow} label={stageAlt ?? `${title}: a recording of the product in use.`} pausable />
        {heroNotes && !comingSoon && (
          <ol class="notes" role="list" aria-label="What to notice in the recording">
            {heroNotes.map((n, i) => (
              <li>
                <span class="note-n" aria-hidden="true">{i + 1}</span>
                <span><span class="sr-only-text">{i + 1}. </span>{n}</span>
              </li>
            ))}
          </ol>
        )}
      </div>
    ) : (
      <div class="stage-wrap">
        <Stage slug={entry.id} title={title} platform={platform} size="hero" alt={stageAlt} />
      </div>
    )
  }
</header>

<style>
  .hero {
    display: grid;
    gap: 22px;
    justify-items: center;
    text-align: center;
    padding-bottom: clamp(32px, 6vw, 64px);
  }
  .back {
    margin-bottom: -6px;
  }
  .eyebrow {
    margin: 0;
    font-size: 13px;
    font-weight: 600;
    color: var(--accent-strong);
  }
  h1 {
    margin: -10px 0 0;
    font-size: clamp(36px, 5vw, 56px);
    line-height: 1.04;
    letter-spacing: -0.02em;
    font-weight: 650;
    text-wrap: balance;
  }
  .lede {
    margin: 0;
    max-width: 58ch;
    font-size: 17px;
    line-height: 1.55;
    color: var(--muted);
  }
  .meta {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px 28px;
    font-size: 14px;
    color: var(--muted);
  }
  .meta div {
    display: flex;
    gap: 6px;
  }
  .meta dt {
    font-weight: 600;
    color: var(--ink);
  }
  .meta dd {
    margin: 0;
  }

  /* The demo button and the three summary bullets: left-aligned lines in a centered block. */
  .highlights {
    margin: -4px 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 8px;
    max-width: 62ch;
    text-align: start;
    font-size: 15px;
    line-height: 1.5;
    color: var(--ink);
  }
  .highlights li {
    display: flex;
    gap: 10px;
    align-items: flex-start;
  }
  .highlights svg {
    flex: none;
    margin-top: 3px;
    color: var(--accent-strong);
  }
  /* Numbered notes under the recording: what to notice, in order. */
  .notes {
    margin: clamp(32px, 4vw, 44px) auto 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 10px 24px;
    max-width: 860px;
    text-align: start;
  }
  @media (min-width: 47.5rem) {
    .notes {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .notes li {
    display: flex;
    gap: 10px;
    align-items: baseline;
    font-size: 15px;
    line-height: 1.45;
    color: var(--muted);
  }
  .note-n {
    flex: none;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: var(--accent);
    color: var(--on-accent);
    font-size: 12px;
    font-weight: 700;
    transform: translateY(-1px);
  }

  .showcase {
    position: relative;
    width: 100%;
    padding: 28px 0 46px;
  }
  .soon-wrap {
    width: 100%;
    max-width: 240px;
    padding-top: 12px;
  }
  .trio {
    margin: 0;
    padding: 24px 0 0;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(14px, 3vw, 36px);
    align-items: end;
    width: 100%;
    max-width: 920px;
  }
  .trio li {
    display: grid;
    gap: 14px;
    justify-items: center;
    min-width: 0;
  }
  .trio :global(.phone) {
    max-width: 250px;
  }
  .trio li:nth-child(2) :global(.phone) {
    max-width: 290px;
  }
  .trio li:nth-child(1),
  .trio li:nth-child(3) {
    transform: translateY(-18px);
  }
  .trio-cap {
    margin: 0;
    font-size: 14px;
    line-height: 1.45;
    color: var(--muted);
  }
  .trio-cap b {
    font-weight: 600;
    color: var(--ink);
  }
  @media (max-width: 47.49rem) {
    .trio {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .trio li:nth-child(3) {
      display: none;
    }
    .trio li:nth-child(1) {
      transform: none;
    }
    .trio-cap {
      font-size: 13px;
    }
    /* With a photo last, keep it and leave out the first phone instead. */
    .trio--photo li:nth-child(3) {
      display: grid;
      transform: none;
    }
    .trio--photo li:nth-child(1) {
      display: none;
    }
  }
  .trio :global(.trio-photo) {
    max-width: 260px;
  }
  .stage-wrap {
    width: 100%;
    text-align: start;
  }
  @media (max-width: 47.49rem) {
    /* The demo button and the three summary bullets: left-aligned lines in a centered block. */
  .highlights {
    margin: -4px 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 8px;
    max-width: 62ch;
    text-align: start;
    font-size: 15px;
    line-height: 1.5;
    color: var(--ink);
  }
  .highlights li {
    display: flex;
    gap: 10px;
    align-items: flex-start;
  }
  .highlights svg {
    flex: none;
    margin-top: 3px;
    color: var(--accent-strong);
  }
  /* Numbered notes under the recording: what to notice, in order. */
  .notes {
    margin: clamp(32px, 4vw, 44px) auto 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 10px 24px;
    max-width: 860px;
    text-align: start;
  }
  @media (min-width: 47.5rem) {
    .notes {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .notes li {
    display: flex;
    gap: 10px;
    align-items: baseline;
    font-size: 15px;
    line-height: 1.45;
    color: var(--muted);
  }
  .note-n {
    flex: none;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: var(--accent);
    color: var(--on-accent);
    font-size: 12px;
    font-weight: 700;
    transform: translateY(-1px);
  }

  .showcase {
      padding: 20px 0 32px;
    }
  }

  /* The origin note: a small framed line under the meta row, read with the status. */
  .origin {
    margin: -6px 0 0;
    display: flex;
    gap: 10px;
    align-items: flex-start;
    max-width: 68ch;
    padding: 10px 16px;
    border: 1px solid var(--line);
    border-radius: var(--radius-frame);
    background: var(--surface);
    font-size: 14px;
    line-height: 1.55;
    color: var(--muted);
    text-align: start;
  }
  .origin svg {
    flex: none;
    margin-top: 3px;
    color: var(--accent-strong);
  }
</style>
