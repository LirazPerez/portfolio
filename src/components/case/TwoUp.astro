---
/**
 * Two things side by side inside a decision (two app cards, a photo and a timeline, a sample
 * and a comparison). Two columns from 600px of its own width, stacked below.
 * Children are any visuals; `Shot` is the plain card-sized app still.
 */
---

<div class="wrap">
  <div class="two">
    <slot />
  </div>
</div>

<style>
  .wrap {
    container-type: inline-size;
  }
  .two {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 16px;
    align-items: start;
  }
  @container (min-width: 600px) {
    .two {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .two > :global(*) {
    min-width: 0;
  }
</style>
