---
/**
 * Rules written before the build: one short card each, a title over one line. `firm` rules
 * (the ones nothing bends) get the accent tint and border, and say "Firm rule" to screen
 * readers; their own words say the same. Under the cards, an optional work loop: the steps
 * of every phase as pills joined by arrows (an ordered list).
 * With a `legend`, a small key sits above the cards (filled = firm, outline = the rest, so the
 * swatches differ in shape as well as color), and the cards are grouped in two rows by type:
 * the firm rules first, the others under them, each row sharing the width evenly.
 * Rows go one per line below 37.5rem.
 */
interface Props {
  rules: { title: string; text: string; firm?: boolean }[];
  legend?: { firm: string; other: string };
  loop?: string[];
  loopLabel?: string;
}
const { rules, legend, loop, loopLabel = 'Each phase' } = Astro.props;
const firmLabel = legend?.firm ?? 'Firm rule';
const otherLabel = legend?.other;
const groups = [rules.filter((r) => r.firm), rules.filter((r) => !r.firm)].filter((g) => g.length > 0);
---

<div class="wrap">
  {
    legend && (
      <ul class="legend" role="list">
        <li><i class="sw sw--firm" aria-hidden="true"></i>{legend.firm}</li>
        <li><i class="sw" aria-hidden="true"></i>{legend.other}</li>
      </ul>
    )
  }
  {groups.map((group) => (
    <ul class="rules" role="list" style={`--count:${group.length}`}>
      {group.map((r) => (
        <li class:list={['rule', r.firm && 'rule--firm']}>
          <h3>
            {r.firm ? <span class="sr-only-text">{firmLabel}: </span> : otherLabel && <span class="sr-only-text">{otherLabel}: </span>}
            {r.title}
          </h3>
          <p>{r.text}</p>
        </li>
      ))}
    </ul>
  ))}
  {
    loop && (
      <ol class="loop" role="list" aria-label={loopLabel}>
        {loop.map((s, i) => (
          <li>
            {i > 0 && <span class="arrow" aria-hidden="true">→</span>}
            <span class="pill">{s}</span>
          </li>
        ))}
      </ol>
    )
  }
</div>

<style>
  .wrap {
    container-type: inline-size;
    display: grid;
    gap: 18px;
  }
  .rules {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 10px;
  }
  @media (min-width: 37.5rem) {
    .rules {
      grid-template-columns: repeat(var(--count, 3), minmax(0, 1fr));
    }
  }
  .rules + .rules {
    margin-top: -8px;
  }
  .legend {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 6px 16px;
    font-size: 13px;
    color: var(--muted);
  }
  .legend li {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .sw {
    width: 14px;
    height: 10px;
    border-radius: 3px;
    border: 1.5px solid var(--muted);
    background: var(--raise);
  }
  .sw--firm {
    border-color: var(--accent);
    background: var(--accent-tint);
  }
  .rule {
    display: grid;
    gap: 6px;
    align-content: start;
    padding: 14px;
    border: 1px solid var(--line);
    border-radius: 14px;
    background: var(--raise);
  }
  .rule--firm {
    border-color: color-mix(in srgb, var(--accent) 45%, transparent);
    background: var(--accent-tint);
  }
  h3 {
    margin: 0;
    font-size: 15px;
    line-height: 1.3;
    font-weight: 600;
  }
  p {
    margin: 0;
    font-size: 13px;
    line-height: 1.45;
    color: var(--muted);
  }
  .loop {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    align-items: center;
    font-size: 13.5px;
  }
  .loop li {
    display: inline-flex;
    gap: 6px;
    align-items: center;
  }
  .arrow {
    color: var(--muted);
  }
  .pill {
    padding: 5px 12px;
    border: 1px solid var(--line);
    border-radius: var(--radius-pill);
    background: var(--raise);
  }
</style>
