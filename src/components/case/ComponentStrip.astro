---
/**
 * The new components, as short loops side by side: each a clip, its name (### level) and
 * one line. Each clip is cropped tight to its component and fills its column, so the UI
 * reads at close to its real size. Two across from 600px of its own width; an odd last item
 * spans the row with its text beside the clip. Stacked below 600px. Loops play only when motion is allowed and on screen; posters otherwise.
 *
 * `phone: true` shows an item as a full-screen recording in a <Phone> instead of a tight crop
 * (for a component whose dropdown would otherwise leave empty space in its frame). It spans
 * the row with its text beside the phone, and is left out when pairing the cropped clips.
 */
import ClipFrame from './ClipFrame.astro';
import Phone from '../Phone.astro';
import { workClip } from '../../lib/stage-media';

interface Props {
  project: string;
  items: { clip: string; name: string; line: string; alt: string; phone?: boolean }[];
}
const { project, items } = Astro.props;
---

<div class="wrap">
  <ul class="strip" role="list">
    {
      items.map((item) => (
        <li class:list={[item.phone && 'is-phone']}>
          {item.phone ? (
            <div class="phone-col">
              {(() => {
                const media = workClip(project, item.clip);
                return media ? (
                  <Phone media={media} label={item.alt} />
                ) : (
                  <p class="missing">Recording to add: {item.clip}</p>
                );
              })()}
            </div>
          ) : (
            <ClipFrame project={project} clip={item.clip} alt={item.alt} />
          )}
          <div class="txt">
            <h4>{item.name}</h4>
            <p>{item.line}</p>
          </div>
        </li>
      ))
    }
  </ul>
</div>

<style>
  .wrap {
    container-type: inline-size;
  }
  .strip {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 24px 14px;
  }
  @container (min-width: 600px) {
    .strip {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 40px 24px;
    }
    li:nth-last-child(1 of :not(.is-phone)):nth-child(odd of :not(.is-phone)) {
      grid-column: 1 / -1;
      grid-template-columns: minmax(0, calc(50% - 12px)) minmax(0, 1fr);
      gap: 24px;
      align-items: center;
    }
    li.is-phone {
      grid-column: 1 / -1;
      grid-template-columns: minmax(0, 220px) minmax(0, 1fr);
      gap: clamp(24px, 6cqi, 64px);
    }
    /* Like a flow: the text starts near the phone's top third. */
    li.is-phone .txt {
      padding-top: clamp(24px, 9cqi, 72px);
    }
  }
  .phone-col :global(.phone) {
    max-width: 210px;
  }
  @container (min-width: 600px) {
    .phone-col :global(.phone) {
      max-width: 220px;
    }
  }
  .missing {
    padding: 24px;
    border: 1px dashed var(--muted);
    border-radius: var(--radius-frame);
    font-size: 13px;
  }
  li {
    display: grid;
    gap: 8px;
    align-content: start;
    min-width: 0;
  }
  li :global(.clip) {
    max-width: 380px;
  }
  .txt {
    display: grid;
    gap: 6px;
    align-content: start;
  }
  h4 {
    margin: 0;
    font-size: 15px;
    line-height: 1.3;
    font-weight: 600;
  }
  p {
    margin: 0;
    font-size: 14px;
    line-height: 1.5;
    color: var(--muted);
  }
</style>
