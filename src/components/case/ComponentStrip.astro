---
/**
 * The new components, as short loops side by side: each a clip, its name (### level) and
 * one line. Each clip is cropped tight to its component and fills its column, so the UI
 * reads at close to its real size. Two across from 600px of its own width; an odd last item
 * spans the row with its text beside the clip. Stacked below 600px. Loops play only when motion is allowed and on screen; posters otherwise.
 */
import ClipFrame from './ClipFrame.astro';

interface Props {
  project: string;
  items: { clip: string; name: string; line: string; alt: string }[];
}
const { project, items } = Astro.props;
---

<div class="wrap">
  <ul class="strip" role="list">
    {
      items.map((item) => (
        <li>
          <ClipFrame project={project} clip={item.clip} alt={item.alt} />
          <div class="txt">
            <h4>{item.name}</h4>
            <p>{item.line}</p>
          </div>
        </li>
      ))
    }
  </ul>
</div>

<style>
  .wrap {
    container-type: inline-size;
  }
  .strip {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 24px 14px;
  }
  @container (min-width: 600px) {
    .strip {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 40px 24px;
    }
    li:last-child:nth-child(odd) {
      grid-column: 1 / -1;
      grid-template-columns: minmax(0, calc(50% - 12px)) minmax(0, 1fr);
      gap: 24px;
      align-items: center;
    }
  }
  li {
    display: grid;
    gap: 8px;
    align-content: start;
    min-width: 0;
  }
  li :global(.clip) {
    max-width: 380px;
  }
  .txt {
    display: grid;
    gap: 6px;
  }
  h4 {
    margin: 0;
    font-size: 15px;
    line-height: 1.3;
    font-weight: 600;
  }
  p {
    margin: 0;
    font-size: 14px;
    line-height: 1.5;
    color: var(--muted);
  }
</style>
