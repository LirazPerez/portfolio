---
/**
 * A sub-part inside a case-study section (e.g. "Edge cases" inside Process): a small
 * eyebrow that is the ### heading, then a headline sentence and an optional lede, sized one
 * step below the section's own Intro.
 */
interface Props {
  eyebrow: string;
  headline?: string;
  lede?: string;
}
const { eyebrow, headline, lede } = Astro.props;
---

<div class="sub">
  <h3>{eyebrow}</h3>
  {headline && <p class="headline">{headline}</p>}
  {lede && <p class="lede">{lede}</p>}
</div>

<style>
  .sub {
    display: grid;
    gap: 8px;
    margin-top: clamp(24px, 4vw, 40px);
  }
  h3 {
    margin: 0;
    font-size: 13px;
    line-height: 1.4;
    font-weight: 600;
    color: var(--accent-strong);
  }
  .headline {
    margin: 0;
    font-size: clamp(22px, 2.6vw, 28px);
    line-height: 1.2;
    letter-spacing: -0.01em;
    font-weight: 620;
    text-wrap: balance;
  }
  .lede {
    margin: 0;
    max-width: 58ch;
    font-size: 16px;
    line-height: 1.55;
    color: var(--muted);
  }
</style>
