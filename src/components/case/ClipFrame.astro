---
/**
 * A short component loop (src/assets/work/<project>/<clip>.mp4, .webm, <clip>-poster.*) in a
 * quiet frame: hairline border, raised surface, its own aspect ratio from the poster. One
 * image to assistive tech (`alt`); the video is aria-hidden and plays only when motion is
 * allowed and it is on screen. A missing clip renders a tagged placeholder.
 */
import StageVideo from '../StageVideo.astro';
import { workClip } from '../../lib/stage-media';

interface Props {
  project: string;
  clip: string;
  alt: string;
  /** Cap the frame's height (CSS length); the clip keeps its ratio and is cropped from the top. */
  maxHeight?: string;
  /** Cap the frame's width (CSS length). */
  maxWidth?: string;
  /** A fixed frame ratio (e.g. "3 / 4") with the whole clip fitted inside, so a row of clips lines up. */
  ratio?: string;
  class?: string;
}
const { project, clip, alt, maxHeight, maxWidth, ratio: fixedRatio, class: className } = Astro.props;
const media = workClip(project, clip);
const ratio = fixedRatio ?? (media?.poster ? `${media.poster.width} / ${media.poster.height}` : '4 / 5');
---

{
  media ? (
    <div
      class:list={['clip', fixedRatio && 'clip--fit', className]}
      role="img"
      aria-label={alt}
      style={`--ratio: ${ratio};${maxHeight ? ` --max-h: ${maxHeight};` : ''}${maxWidth ? ` --max-w: ${maxWidth};` : ''}`}
    >
      <StageVideo sources={media.videos} poster={media.poster} />
    </div>
  ) : (
    <div class:list={['clip clip--missing', className]}>
      <span><b>Clip to add:</b> {clip}</span>
    </div>
  )
}

<style>
  .clip {
    position: relative;
    width: 100%;
    aspect-ratio: var(--ratio);
    max-height: var(--max-h, none);
    max-width: var(--max-w, none);
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius-frame);
    background: var(--raise);
  }
  .clip--fit :global(video) {
    object-fit: contain;
    object-position: center;
  }
  .clip--missing {
    display: grid;
    place-items: center;
    padding: 16px;
    font-size: 13px;
    color: var(--muted);
    border-style: dashed;
  }
</style>
