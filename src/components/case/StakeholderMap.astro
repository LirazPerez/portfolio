---
/**
 * Who touches the product: the product as a hub, the owner on top (accent node, heavier
 * link, and its own sub-line says "owner", so color is never the only cue), and everyone
 * else around it. Pure SVG, tokens only. Positions are computed, so any number of nodes
 * works.
 *
 * Two drawings of the same map: a ring from 480px of its own width, and a vertical spine
 * below that, so labels stay readable on phones. Only one is displayed, so only one is in
 * the accessibility tree; both carry the full `label`.
 */
interface Node {
  label: string;
  sub?: string;
}
interface Props {
  /** Full text alternative: the hub, the owner, and every node. */
  label: string;
  hub: string;
  owner: Node;
  nodes: Node[];
}
const { label, hub, owner, nodes } = Astro.props;

// Rough Geist advance widths, enough to size the boxes.
const textWidth = (n: Node, lbl: number, sub: number) =>
  Math.max(n.label.length * lbl, (n.sub?.length ?? 0) * sub);

// ---- Ring (wide) ----
const W = 560;
const H = 420;
const cx = W / 2;
const cy = H / 2;
const all = [owner, ...nodes];
// The owner sits at the top; everyone else spreads evenly over the rest of the ring,
// leaving a wider gap on either side of the owner's larger box.
const GAP = (50 * Math.PI) / 180;
const step = nodes.length > 1 ? (2 * Math.PI - 2 * GAP) / (nodes.length - 1) : 0;
const ring = all.map((n, i) => {
  const a = i === 0 ? -Math.PI / 2 : -Math.PI / 2 + GAP + (i - 1) * step;
  const w = Math.round(textWidth(n, 7.5, 6.1) + 28);
  const h = i === 0 ? 54 : n.sub ? 46 : 40;
  let x = cx + Math.cos(a) * 205;
  const y = cy + Math.sin(a) * 158;
  x = Math.min(Math.max(x, 4 + w / 2), W - 4 - w / 2);
  return { ...n, x, y, w, h, own: i === 0 };
});

// ---- Spine (narrow) ----
const NW = 340;
const top = 92;
const rowH = 60;
const spine = all.map((n, i) => ({ ...n, y: top + i * rowH, own: i === 0 }));
const NH = top + all.length * rowH - 4;
---

<div class="map">
  <svg class="map-ring" viewBox={`0 0 ${W} ${H}`} role="img" aria-label={label}>
    {ring.map((n) => <line class:list={['link', n.own && 'link--own']} x1={cx} y1={cy} x2={n.x} y2={n.y} />)}
    <circle class="hub" cx={cx} cy={cy} r="54" />
    <text class="hub-t" x={cx} y={cy + 5} text-anchor="middle">{hub}</text>
    {
      ring.map((n) => (
        <g>
          <rect class:list={['node', n.own && 'node--own']} x={n.x - n.w / 2} y={n.y - n.h / 2} width={n.w} height={n.h} rx="12" />
          {n.sub ? (
            <>
              <text class="lbl" x={n.x} y={n.y - (n.own ? 4 : 3)} text-anchor="middle">{n.label}</text>
              <text class="sub" x={n.x} y={n.y + (n.own ? 13 : 12)} text-anchor="middle">{n.sub}</text>
            </>
          ) : (
            <text class="lbl" x={n.x} y={n.y + 5} text-anchor="middle">{n.label}</text>
          )}
        </g>
      ))
    }
  </svg>

  <svg class="map-spine" viewBox={`0 0 ${NW} ${NH}`} role="img" aria-label={label}>
    <line class="link" x1="26" y1="60" x2="26" y2={spine[spine.length - 1].y + 25} />
    {spine.map((n) => <line class:list={['link', n.own && 'link--own']} x1="26" y1={n.y + 25} x2="46" y2={n.y + 25} />)}
    <rect class="hub" x="2" y="4" width={NW - 4} height="56" rx="28" />
    <text class="hub-t" x={NW / 2} y="38" text-anchor="middle">{hub}</text>
    {
      spine.map((n) => (
        <g>
          <rect class:list={['node', n.own && 'node--own']} x="46" y={n.y} width={NW - 48} height="50" rx="12" />
          {n.sub ? (
            <>
              <text class="lbl lbl--n" x="62" y={n.y + 21}>{n.label}</text>
              <text class="sub sub--n" x="62" y={n.y + 38}>{n.sub}</text>
            </>
          ) : (
            <text class="lbl lbl--n" x="62" y={n.y + 30}>{n.label}</text>
          )}
        </g>
      ))
    }
  </svg>
</div>

<style>
  .map {
    container-type: inline-size;
    padding: clamp(18px, 3vw, 28px);
    border: 1px solid var(--line);
    border-radius: var(--radius-card);
    background: var(--raise);
  }
  svg {
    display: block;
    width: 100%;
    height: auto;
    margin-inline: auto;
  }
  .map-ring {
    display: none;
    max-width: 600px;
  }
  .map-spine {
    max-width: 420px;
  }
  @container (min-width: 480px) {
    .map-ring {
      display: block;
    }
    .map-spine {
      display: none;
    }
  }
  text {
    font-family: inherit;
  }
  .hub {
    fill: var(--accent);
  }
  .hub-t {
    fill: var(--on-accent);
    font-weight: 700;
    font-size: 15px;
  }
  .node {
    fill: var(--raise);
    stroke: var(--muted);
    stroke-opacity: 0.5;
  }
  .node--own {
    fill: var(--accent-tint);
    stroke: var(--accent);
    stroke-opacity: 1;
    stroke-width: 1.5;
  }
  .lbl {
    fill: var(--ink);
    font-size: 13px;
    font-weight: 600;
  }
  .sub {
    fill: var(--muted);
    font-size: 11px;
  }
  .lbl--n {
    font-size: 14px;
  }
  .sub--n {
    font-size: 12px;
  }
  .link {
    stroke: var(--line);
    stroke-width: 1.5;
  }
  .link--own {
    stroke: var(--accent);
    stroke-width: 2.5;
  }
</style>
