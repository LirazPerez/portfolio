---
/**
 * One product flow: its recording in a phone on one side; on the other, an eyebrow
 * ("1 · Capture"), the flow's line as a ### heading, the steps as small pills joined by
 * arrows (an ordered list), and the key decision. `flip` puts the phone on the right.
 * An optional component loop (`component`) sits under the decision.
 * Two columns from 600px of its own width; below that the phone comes first.
 */
import Phone from '../Phone.astro';
import ClipFrame from './ClipFrame.astro';
import { workClip } from '../../lib/stage-media';

interface Props {
  project: string;
  clip: string;
  alt: string;
  eyebrow: string;
  title: string;
  steps: string[];
  decision: string;
  flip?: boolean;
  component?: { clip: string; name: string; alt: string };
}
const { project, clip, alt, eyebrow, title, steps, decision, flip = false, component } = Astro.props;
const media = workClip(project, clip);
---

<div class="wrap">
  <article class:list={['row', flip && 'row--flip']}>
    <div class="phone-col">
      {media ? <Phone media={media} label={alt} /> : <p class="missing">Recording to add: {clip}</p>}
    </div>
    <div class="txt">
      <p class="eyebrow">{eyebrow}</p>
      <h3>{title}</h3>
      <ol class="steps" role="list" aria-label="Steps">
        {steps.map((s, i) => (
          <li>
            {i > 0 && <span class="arrow" aria-hidden="true">→</span>}
            <span class="pill">{s}</span>
          </li>
        ))}
      </ol>
      <p class="decision"><b>Key decision</b> {decision}</p>
      {
        component && (
          <figure class="comp">
            <ClipFrame project={project} clip={component.clip} alt={component.alt} />
            <figcaption>Component · {component.name}</figcaption>
          </figure>
        )
      }
    </div>
  </article>
</div>

<style>
  .wrap {
    container-type: inline-size;
  }
  .row {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 24px;
    align-items: center;
  }
  .phone-col :global(.phone) {
    max-width: 240px;
  }
  @container (min-width: 600px) {
    .row {
      grid-template-columns: minmax(0, 280px) minmax(0, 1fr);
      gap: clamp(24px, 5cqi, 56px);
    }
    .row--flip {
      grid-template-columns: minmax(0, 1fr) minmax(0, 280px);
    }
    .row--flip .phone-col {
      order: 2;
    }
    .phone-col :global(.phone) {
      max-width: 280px;
    }
  }
  p {
    margin: 0;
  }
  .txt {
    display: grid;
    gap: 12px;
    min-width: 0;
  }
  .eyebrow {
    font-size: 13px;
    font-weight: 600;
    color: var(--accent-strong);
  }
  h3 {
    margin: 0;
    font-size: 24px;
    line-height: 1.2;
    letter-spacing: -0.01em;
    font-weight: 600;
  }
  .steps {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    align-items: center;
    font-size: 13px;
  }
  .steps li {
    display: inline-flex;
    gap: 6px;
    align-items: center;
  }
  .arrow {
    color: var(--muted);
  }
  .pill {
    padding: 4px 10px;
    border: 1px solid var(--line);
    border-radius: var(--radius-pill);
    background: var(--raise);
  }
  .decision {
    display: grid;
    gap: 4px;
    padding: 14px 16px;
    border-left: 3px solid var(--accent);
    border-radius: 0 10px 10px 0;
    background: var(--surface);
    font-size: 14.5px;
    line-height: 1.5;
  }
  .decision b {
    font-size: 12.5px;
    font-weight: 600;
    color: var(--accent-strong);
  }
  .comp {
    margin: 4px 0 0;
    display: grid;
    gap: 8px;
    max-width: 320px;
  }
  .comp figcaption {
    font-size: 13px;
    color: var(--muted);
  }
  .missing {
    padding: 24px;
    border: 1px dashed var(--muted);
    border-radius: var(--radius-frame);
    font-size: 13px;
    color: var(--muted);
  }
</style>
