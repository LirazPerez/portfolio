---
/**
 * One product flow: its recording in a phone on one side; on the other, an eyebrow
 * ("1 · Capture"), the flow's line as a #### heading (it sits under a SubIntro's ###; `level={3}` when it sits right under the section's ##), the steps as small pills joined by
 * arrows (an ordered list), and the key decision. `flip` puts the phone on the right.
 * An optional component loop (`component`) sits under the decision.
 * Two columns from 600px of its own width; below that the phone comes first. The text
 * starts near the phone's top third rather than its middle. Consecutive flows are set
 * apart by extra space and a hairline, so each reads as its own stop.
 * `native` plays a Simulator recording in the native phone (see Phone.astro).
 * Optional: a first-person `lede` under the heading, and under the decision a `note` with
 * `chips`: small cards, each a bold lead and a line, two per row when the row has two
 * columns, one per row below.
 */
import Phone from '../Phone.astro';
import ClipFrame from './ClipFrame.astro';
import { workClip } from '../../lib/stage-media';

interface Props {
  project: string;
  clip: string;
  alt: string;
  eyebrow: string;
  title: string;
  steps: string[];
  decision: string;
  flip?: boolean;
  component?: { clip: string; name: string; alt: string };
  native?: boolean;
  lede?: string;
  note?: string;
  chips?: { lead: string; text: string }[];
  /** Heading level of the flow's line: 4 under a SubIntro (default), 3 straight under the section. */
  level?: 3 | 4;
}
const { project, clip, alt, eyebrow, title, steps, decision, flip = false, component, native = false, lede, note, chips, level = 4 } = Astro.props;
const Heading = `h${level}` as 'h3' | 'h4';
const media = workClip(project, clip);
---

<div class="wrap">
  <article class:list={['row', flip && 'row--flip']}>
    <div class="phone-col">
      {media ? <Phone media={media} label={alt} native={native} /> : <p class="missing">Recording to add: {clip}</p>}
    </div>
    <div class="txt">
      <p class="eyebrow">{eyebrow}</p>
      <Heading class="flow-title">{title}</Heading>
      {lede && <p class="lede">{lede}</p>}
      <ol class="steps" role="list" aria-label="Steps">
        {steps.map((s, i) => (
          <li>
            {i > 0 && <span class="arrow" aria-hidden="true">→</span>}
            <span class="pill">{s}</span>
          </li>
        ))}
      </ol>
      <p class="decision"><b>Key decision</b> {decision}</p>
      {note && <p class="note">{note}</p>}
      {
        chips && (
          <ul class="uses" role="list">
            {chips.map((c) => (
              <li class="use">
                <b>{c.lead}:</b> {c.text}
              </li>
            ))}
          </ul>
        )
      }
      {
        component && (
          <figure class="comp">
            <ClipFrame project={project} clip={component.clip} alt={component.alt} />
            <figcaption>Component · {component.name}</figcaption>
          </figure>
        )
      }
    </div>
  </article>
</div>

<style>
  .wrap {
    container-type: inline-size;
  }
  .wrap + .wrap {
    margin-top: 12px;
    padding-top: clamp(32px, 5vw, 48px);
    border-top: 1px solid var(--line);
  }
  .row {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 24px;
    align-items: center;
  }
  .phone-col :global(.phone) {
    max-width: 210px;
  }
  @container (min-width: 600px) {
    .row {
      grid-template-columns: minmax(0, 245px) minmax(0, 1fr);
      gap: clamp(24px, 6cqi, 64px);
      align-items: start;
    }
    .row--flip {
      grid-template-columns: minmax(0, 1fr) minmax(0, 245px);
    }
    .row--flip .phone-col {
      order: 2;
    }
    .phone-col :global(.phone) {
      max-width: 245px;
    }
    /* Start the text near the phone's top third, not its exact middle. */
    .txt {
      padding-top: clamp(24px, 9cqi, 72px);
    }
  }
  p {
    margin: 0;
  }
  .txt {
    display: grid;
    gap: 12px;
    min-width: 0;
  }
  .eyebrow {
    font-size: 13px;
    font-weight: 600;
    color: var(--accent-strong);
  }
  .flow-title {
    margin: 0;
    font-size: 24px;
    line-height: 1.2;
    letter-spacing: -0.01em;
    font-weight: 600;
  }
  .steps {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    align-items: center;
    font-size: 13px;
  }
  .steps li {
    display: inline-flex;
    gap: 6px;
    align-items: center;
  }
  .arrow {
    color: var(--muted);
  }
  .pill {
    padding: 4px 10px;
    border: 1px solid var(--line);
    border-radius: var(--radius-pill);
    background: var(--raise);
  }
  .decision {
    display: grid;
    gap: 4px;
    padding: 14px 16px;
    border-left: 3px solid var(--accent);
    border-radius: 0 10px 10px 0;
    background: var(--surface);
    font-size: 14.5px;
    line-height: 1.5;
  }
  .decision b {
    font-size: 12.5px;
    font-weight: 600;
    color: var(--accent-strong);
  }
  .comp {
    margin: 4px 0 0;
    display: grid;
    gap: 8px;
    max-width: 320px;
  }
  .comp figcaption {
    font-size: 13px;
    color: var(--muted);
  }
  .missing {
    padding: 24px;
    border: 1px dashed var(--muted);
    border-radius: var(--radius-frame);
    font-size: 13px;
    color: var(--muted);
  }
  .lede {
    max-width: 52ch;
    font-size: 16px;
    line-height: 1.55;
    color: var(--ink);
  }
  .note {
    margin-top: 4px;
    font-size: 15px;
    line-height: 1.55;
    color: var(--ink);
  }
  .uses {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 12px;
  }
  @container (min-width: 600px) {
    .uses {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .use {
    padding: 16px 18px;
    border: 1px solid var(--line);
    border-radius: var(--radius-card);
    background: var(--raise);
    font-size: 14px;
    line-height: 1.5;
    color: var(--muted);
  }
  .use b {
    font-weight: 600;
    color: var(--ink);
  }
</style>
