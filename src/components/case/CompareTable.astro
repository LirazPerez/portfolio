---
/**
 * A real comparison <table> in words: a caption (visually hidden), a header row, and one row
 * per situation whose first cell is the row header. The last column is ours: its header names
 * it and it gets the accent tint, so the emphasis never rests on color alone. Below 560px of
 * its own width (where the table would scroll) it becomes one card per row (TableCards), the
 * last column's line still tinted. An optional `note` sits under it as one short muted line.
 */
import TableCards from './TableCards.astro';

interface Props {
  caption: string;
  columns: string[];
  rows: string[][];
  note?: string;
}
const { caption, columns, rows, note } = Astro.props;
const last = columns.length - 1;
const cards = rows.map((row) => ({
  title: row[0],
  lines: row.slice(1).map((value, j) => ({ label: columns[j + 1], value, tone: j + 1 === last ? ('us' as const) : undefined })),
}));
---

<div class="tt">
<div class="frame" tabindex="0" role="region" aria-label={caption}>
  <table>
    <caption class="sr-only-text">{caption}</caption>
    <thead>
      <tr>
        {columns.map((c, i) => (
          <th scope="col" class:list={[i === last && 'us']}>{c}</th>
        ))}
      </tr>
    </thead>
    <tbody>
      {rows.map((row) => (
        <tr>
          {row.map((cell, i) =>
            i === 0 ? <th scope="row">{cell}</th> : <td class:list={[i === last && 'us']}>{cell}</td>,
          )}
        </tr>
      ))}
    </tbody>
  </table>
</div>
<TableCards class="tt-cards" label={caption} cards={cards} />
</div>
{note && <div><p class="table-note">{note}</p></div>}

<style>
  /* The table while it fits; one card per row below that. */
  .tt {
    container-type: inline-size;
  }
  .tt > :global(.tt-cards) {
    display: none;
  }
  @container (max-width: 559.98px) {
    .tt > .frame {
      display: none;
    }
    .tt > :global(.tt-cards) {
      display: grid;
    }
  }
  .frame {
    overflow-x: auto;
    border: 1px solid var(--line);
    border-radius: var(--radius-card);
    background: var(--raise);
  }
  table {
    width: 100%;
    min-width: 560px;
    border-collapse: collapse;
    font-size: 14.5px;
    line-height: 1.45;
  }
  th,
  td {
    padding: 13px 16px;
    border-bottom: 1px solid var(--line);
    text-align: left;
    vertical-align: top;
  }
  thead th {
    font-size: 13px;
    font-weight: 600;
    color: var(--muted);
  }
  tbody th {
    width: 28%;
    font-weight: 600;
  }
  tbody tr:last-child > * {
    border-bottom: 0;
  }
  .us {
    background: var(--accent-tint);
  }
  thead .us {
    color: var(--accent-strong);
  }
  .table-note {
    margin: 0;
    max-width: 68ch;
    font-size: 15px;
    line-height: 1.55;
    color: var(--muted);
  }
</style>
