---
/**
 * Two ways saving fails, side by side: each a label, the quote, one line, and a small pin
 * drawing (decorative, aria-hidden; the words carry the meaning). Under-capture draws three
 * empty pins; over-capture a pile of pins where most have faded out of reach.
 * Stacks below 560px of its own width.
 */
interface Mode {
  label: string;
  quote: string;
  note: string;
}
interface Props {
  under: Mode;
  over: Mode;
}
const { under, over } = Astro.props;
// Which of the twenty pins are still findable (the rest fade).
const KEPT = new Set([0, 2, 5, 8, 12, 17]);
---

<div class="wrap">
  <div class="modes">
    {
      [
        { ...under, kind: 'under' },
        { ...over, kind: 'over' },
      ].map((m) => (
        <div class="mode">
          <p class="label">{m.label}</p>
          <p class="quote">“{m.quote}”</p>
          <p class="note">{m.note}</p>
          <div class:list={['viz', m.kind === 'under' && 'viz--empty']} aria-hidden="true">
            {m.kind === 'under'
              ? [0, 1, 2].map(() => <i />)
              : Array.from({ length: 20 }, (_, i) => <i class:list={[!KEPT.has(i) && 'lost']} />)}
          </div>
        </div>
      ))
    }
  </div>
</div>

<style>
  .wrap {
    container-type: inline-size;
  }
  .modes {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 12px;
  }
  @container (min-width: 560px) {
    .modes {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }
  }
  .mode {
    display: grid;
    gap: 10px;
    align-content: start;
    padding: 18px;
    border: 1px solid var(--line);
    border-radius: var(--radius-frame);
    background: var(--surface);
  }
  p {
    margin: 0;
  }
  .label {
    font-size: 13px;
    font-weight: 600;
    color: var(--warn);
  }
  .quote {
    font-size: 19px;
    font-weight: 600;
    line-height: 1.3;
  }
  .note {
    font-size: 14.5px;
    line-height: 1.5;
    color: var(--muted);
  }
  .viz {
    display: flex;
    flex-wrap: wrap;
    gap: 5px;
    margin-top: 4px;
  }
  .viz i {
    width: 12px;
    height: 12px;
    border-radius: 50% 50% 50% 0;
    transform: rotate(-45deg);
    background: var(--muted);
    opacity: 0.35;
  }
  .viz i.lost {
    opacity: 0.12;
  }
  .viz--empty i {
    background: transparent;
    border: 1.5px dashed var(--muted);
    opacity: 0.6;
  }
</style>
