---
/**
 * Screens drawn in markup for AI lab work that has nothing public to show (the job search
 * agent runs on private accounts). Every row is an example and says so. Site tokens only,
 * so they follow the theme like the browser window around them.
 * `compact` is the small version on the carousel card cover (fewer rows, no extra columns).
 */
import type { LabDrawn } from '../data/lab';

interface Props {
  id: LabDrawn;
  compact?: boolean;
}
const { id, compact = false } = Astro.props;

const rows = [
  { role: 'Product Designer', company: 'Cyber security startup', years: '2–4', fit: 'Strong fit' },
  { role: 'UX/UI Designer', company: 'Fintech scale-up', years: '3+', fit: 'Good fit' },
  { role: 'Design Engineer', company: 'AI platform', years: '1–3', fit: 'Stretch' },
];
const shown = compact ? rows.slice(0, 3) : rows;
---

<div class:list={['ld', compact && 'ld--compact']} aria-hidden="true">
  {
    id === 'agent-tracker' && (
      <>
        <div class="ld-top">
          <span class="ld-title">
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" focusable="false"><path d="M4 13h4l2 3h4l2-3h4M4 13l2.5-7h11l2.5 7v6H4z" /></svg>
            New from Agent
          </span>
          <span class="ld-tag">Example rows</span>
        </div>
        <div class="ld-table">
          <div class="ld-row ld-head">
            <span>Role</span>
            <span>Company</span>
            {!compact && <span>Years</span>}
            <span>Fit</span>
          </div>
          {shown.map((r) => (
            <div class="ld-row">
              <span class="ld-strong">{r.role}</span>
              <span>{r.company}</span>
              {!compact && <span>{r.years}</span>}
              <span>
                <span class="ld-pill">{r.fit}</span>
              </span>
            </div>
          ))}
        </div>
        {!compact && (
          <p class="ld-note">
            <b>For:</b> builds prototypes in code. <b>Against:</b> asks for 3+ years. <b>Bottom line:</b> worth a referral.
          </p>
        )}
      </>
    )
  }
  {
    id === 'agent-summary' && (
      <div class="ld-sum">
        <div class="ld-notif">
          <span class="ld-app" />
          <div>
            <p class="ld-strong">Job search agent · Sunday 8:58</p>
            <p>3 new roles are waiting in your tracker.</p>
          </div>
        </div>
        <ol class="ld-list">
          <li><span class="ld-strong">Product Designer</span>, cyber security startup. Strong fit, asks for 2–4 years.</li>
          <li><span class="ld-strong">UX/UI Designer</span>, fintech scale-up. Good fit, a little more seniority than me.</li>
          <li><span class="ld-strong">Design Engineer</span>, AI platform. A stretch, but it wants code prototypes.</li>
        </ol>
        <p class="ld-note">Skipped 6 roles that ask for 5+ years, and 2 already in the tracker.</p>
        <span class="ld-tag">Example run</span>
      </div>
    )
  }
  {
    id === 'agent-rules' && (
      <div class="ld-rules">
        <div>
          <p class="ld-strong">It does</p>
          <ul>
            <li><span class="ld-mark ld-yes">✓</span>Read careers pages, LinkedIn and job boards</li>
            <li><span class="ld-mark ld-yes">✓</span>Skip roles already in my tracker</li>
            <li><span class="ld-mark ld-yes">✓</span>Add new rows, marked New</li>
          </ul>
        </div>
        <div>
          <p class="ld-strong">It never</p>
          <ul>
            <li><span class="ld-mark ld-no">✕</span>Applies for me</li>
            <li><span class="ld-mark ld-no">✕</span>Messages or connects with anyone</li>
            <li><span class="ld-mark ld-no">✕</span>Edits or deletes my rows</li>
          </ul>
        </div>
      </div>
    )
  }
</div>

<style>
  .ld {
    height: 100%;
    display: grid;
    align-content: start;
    gap: 12px;
    padding: 16px 18px;
    background: var(--raise);
    color: var(--ink);
    font-size: 13px;
    line-height: 1.45;
    text-align: left;
  }
  .ld p { margin: 0; }
  .ld-top { display: flex; justify-content: space-between; align-items: center; gap: 8px; }
  .ld-title { display: inline-flex; align-items: center; gap: 7px; font-size: 15px; font-weight: 700; }
  .ld-tag { justify-self: start; font-size: 11px; color: var(--muted); border: 1px dashed var(--line); border-radius: var(--radius-pill); padding: 2px 8px; }
  .ld-table { display: grid; border: 1px solid var(--line); border-radius: var(--radius-control); overflow: hidden; }
  .ld-row { display: grid; grid-template-columns: 1.25fr 1.4fr 0.5fr 0.8fr; gap: 10px; align-items: center; padding: 8px 10px; border-top: 1px solid var(--line); }
  .ld-row:first-child { border-top: 0; }
  .ld-head { background: var(--surface); color: var(--muted); font-size: 12px; }
  .ld-strong { font-weight: 600; }
  .ld-pill { display: inline-block; font-size: 11.5px; font-weight: 600; padding: 2px 8px; border-radius: var(--radius-pill); background: var(--accent-tint); color: var(--accent-strong); white-space: nowrap; }
  .ld-note { color: var(--muted); }
  .ld-note b { color: var(--ink); font-weight: 600; }

  .ld-sum { display: grid; gap: 12px; }
  .ld-notif { display: grid; grid-template-columns: 28px 1fr; gap: 10px; align-items: start; padding: 10px 12px; border: 1px solid var(--line); border-radius: 12px; background: var(--surface); }
  .ld-app { width: 28px; height: 28px; border-radius: 8px; background: var(--accent); }
  .ld-list { margin: 0; padding-left: 18px; list-style: decimal; display: grid; gap: 6px; }

  .ld-rules { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  .ld-rules ul { margin: 8px 0 0; padding: 0; list-style: none; display: grid; gap: 8px; }
  .ld-rules li { display: grid; grid-template-columns: 22px 1fr; gap: 6px; }
  .ld-mark { width: 20px; height: 20px; border-radius: 50%; display: grid; place-items: center; font-size: 11px; font-weight: 700; }
  .ld-yes { background: var(--ok-tint); color: var(--ok); }
  .ld-no { background: var(--warn-tint); color: var(--warn); }

  /* The card cover: a small window, so fewer columns and smaller type. */
  .ld--compact { padding: 10px 11px; gap: 8px; font-size: 10px; }
  .ld--compact .ld-title { font-size: 11.5px; }
  .ld--compact .ld-tag { font-size: 9px; padding: 1px 6px; }
  .ld--compact .ld-row { grid-template-columns: 1.2fr 1.3fr 0.9fr; gap: 6px; padding: 5px 7px; }
  .ld--compact .ld-head { font-size: 9.5px; }
  .ld--compact .ld-pill { font-size: 9px; padding: 1px 6px; }

  @media (max-width: 520px) {
    .ld-rules { grid-template-columns: 1fr; }
    .ld:not(.ld--compact) .ld-row { grid-template-columns: 1.2fr 1.3fr 0.9fr; }
    .ld:not(.ld--compact) .ld-row > :nth-child(3) { display: none; }
  }
</style>
