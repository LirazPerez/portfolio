---
/**
 * "AI lab" on the home page: a stage of its own, so it reads as a different place from the
 * case studies while still speaking the site's language (Geist, the purple, the pills).
 *
 * The stage: a pastel sky (dusk in dark mode) with clouds made of halftone dots. The clouds
 * drift and shift with the pointer, and the dots swell and glow under it. Behind the heading
 * the dots fade out, so its text keeps its contrast. Colors are `--lab-*` custom properties
 * scoped to this section (project colors stay in their stage). Compact on purpose: text on
 * the left and the ring on the right from 900px, so the section costs little scrolling.
 *
 * The carousel: a 3D ring. Arrows, swipe or arrow keys move it; the middle card opens a
 * pop-up (one native <dialog> per project) with its screens, what to notice and the demo.
 * Without JS the cards sit in a plain grid with their demo links, and no pop-up.
 * Reduced motion: the dots are drawn once and do not follow the pointer; the ring moves
 * without transitions (global rule).
 */
import { Image } from 'astro:assets';
import LabDrawn from './LabDrawn.astro';
import { LAB, LAB_EYEBROW, LAB_HEADING, LAB_INTRO, LAB_STATUS_LABEL } from '../data/lab';

const n = LAB.length;
---

<section id="lab" class="lab grid pt-2 pb-8" aria-labelledby="lab-h">
  <div class="lab-stage" data-lab>
    <canvas class="lab-canvas" aria-hidden="true"></canvas>

    <div class="lab-head" data-lab-head>
      <span class="lab-eyebrow">
        <svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor" aria-hidden="true" focusable="false"><circle cx="5" cy="12" r="2" /><circle cx="12" cy="12" r="2" /><circle cx="19" cy="12" r="2" /><circle cx="12" cy="5" r="2" /><circle cx="12" cy="19" r="2" /></svg>
        {LAB_EYEBROW}
      </span>
      <h2 id="lab-h">{LAB_HEADING}</h2>
      <p>{LAB_INTRO}</p>
    </div>

    <div class="lab-car" role="region" aria-roledescription="carousel" aria-label="AI lab projects" data-lab-car>
      <ul class="lab-track" role="list" data-lab-track>
        {
          LAB.map((item, i) => (
            <li class="lab-slide" aria-roledescription="slide" aria-label={`${i + 1} of ${n}`} data-lab-slide>
              <article class="lab-card">
                <div class="lab-cover" data-tone={item.tone}>
                  <span class="lab-ht" aria-hidden="true" />
                  {item.cover.kind === 'phones' ? (
                    item.cover.images.map((img, k) => (
                      <span class:list={['lab-mini', k > 0 && 'lab-mini--back']} aria-hidden="true">
                        <Image src={img} alt="" widths={[160, 320]} sizes="120px" loading="lazy" />
                      </span>
                    ))
                  ) : (
                    <span class="lab-miniwin" aria-hidden="true">
                      <span class="lab-winbar"><i /><i /><i /></span>
                      <LabDrawn id={item.cover.id} compact />
                    </span>
                  )}
                </div>
                <div class="lab-tx">
                  <span class={`lab-status lab-status--${item.status}`}>
                    <i aria-hidden="true" />
                    {LAB_STATUS_LABEL[item.status]}
                  </span>
                  <h3>{item.name}</h3>
                  <p>{item.hook}</p>
                  <button type="button" class="lab-open" data-lab-open={item.id}>
                    Look closer<span class="sr-only-text">: {item.name}</span>
                    <span aria-hidden="true">→</span>
                  </button>
                  {item.cta && (
                    <a class="lab-nojs" href={item.cta.href} target="_blank" rel="noopener">
                      {item.cta.label}
                      <span class="sr-only-text">(opens in a new tab)</span>
                      <span aria-hidden="true">→</span>
                    </a>
                  )}
                </div>
              </article>
            </li>
          ))
        }
      </ul>
      <div class="lab-nav" data-lab-nav hidden>
        <button type="button" data-lab-prev aria-label="Previous project">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" focusable="false"><path d="M15 5l-7 7 7 7" /></svg>
        </button>
        <span class="lab-count" aria-hidden="true" data-lab-count>1 / {n}</span>
        <button type="button" data-lab-next aria-label="Next project">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" focusable="false"><path d="M9 5l7 7-7 7" /></svg>
        </button>
      </div>
      <p class="sr-only-text" aria-live="polite" data-lab-live></p>
    </div>
  </div>

  {
    LAB.map((item) => {
      const phone = item.screens[0]?.kind === 'phone';
      const many = item.screens.length > 1;
      return (
        <dialog class="lab-dlg" id={`lab-dlg-${item.id}`} aria-labelledby={`lab-dlg-${item.id}-h`} data-lab-dialog>
          <div class:list={['lab-sheet', phone ? 'lab-sheet--phone' : 'lab-sheet--window']}>
            <button type="button" class="lab-close" data-lab-close aria-label="Close">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true" focusable="false"><path d="M6 6l12 12M18 6L6 18" /></svg>
            </button>
            <div class="lab-show" data-tone={item.tone}>
              <span class="lab-ht" aria-hidden="true" />
              <div class="lab-screens" aria-live="polite">
                {item.screens.map((s, k) => (
                  <figure class="lab-screen" data-lab-screen={k} hidden={k > 0}>
                    {s.kind === 'phone' ? (
                      <div class="lab-phone" role="img" aria-label={s.alt}>
                        <span class="lab-cut" aria-hidden="true" />
                        <Image src={s.image} alt="" widths={[390, 780]} sizes="230px" loading="lazy" />
                      </div>
                    ) : (
                      <div class="lab-window" role="img" aria-label={s.alt}>
                        <span class="lab-winbar" aria-hidden="true"><i /><i /><i /></span>
                        <LabDrawn id={s.id} />
                      </div>
                    )}
                    <figcaption>
                      {many && <span class="sr-only-text">Screen {k + 1} of {item.screens.length}: </span>}
                      {s.caption}
                    </figcaption>
                  </figure>
                ))}
              </div>
              {many && (
                <div class="lab-ctrls">
                  <button type="button" data-lab-sprev aria-label="Previous screen">
                    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" focusable="false"><path d="M15 5l-7 7 7 7" /></svg>
                  </button>
                  <span class="lab-dots" aria-hidden="true">
                    {item.screens.map((_, k) => <i data-lab-dot={k} class:list={[k === 0 && 'on']} />)}
                  </span>
                  <button type="button" data-lab-snext aria-label="Next screen">
                    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" focusable="false"><path d="M9 5l7 7-7 7" /></svg>
                  </button>
                </div>
              )}
            </div>
            <div class="lab-body">
              <span class="lab-kicker">{LAB_EYEBROW}</span>
              <h2 id={`lab-dlg-${item.id}-h`}>{item.name}</h2>
              <div class="lab-meta">
                <span class={`lab-pill lab-status--${item.status}`}>
                  <i aria-hidden="true" />
                  {LAB_STATUS_LABEL[item.status]}
                </span>
                <span><span class="sr-only-text">Tools: </span>{item.tools.join(' · ')}</span>
              </div>
              <p class="lab-lead">{item.lead}</p>
              <ol class="lab-notes">
                {item.notes.map((note) =>
                  note.screen !== undefined && many ? (
                    <li>
                      <button type="button" data-lab-goto={note.screen}>
                        {note.text}
                        <span class="sr-only-text"> (show screen {note.screen + 1})</span>
                      </button>
                    </li>
                  ) : (
                    <li><span>{note.text}</span></li>
                  ),
                )}
              </ol>
              {item.cta ? (
                <a class="lab-cta" href={item.cta.href} target="_blank" rel="noopener">
                  {item.cta.label}
                  <span class="sr-only-text">(opens in a new tab)</span>
                  <span aria-hidden="true">→</span>
                </a>
              ) : null}
              <p class="lab-small">{item.small}</p>
            </div>
          </div>
        </dialog>
      );
    })
  }
</section>

<style>
  /* ---- Stage colors (this section only). A pastel sky by day, a dusk sky in dark mode. ---- */
  .lab {
    --lab-sky: linear-gradient(170deg, #f9e6f1 0%, #eedaf4 55%, #dcc6f0 100%);
    --lab-ink: #2b1f45;
    --lab-muted: #54456b;
    --lab-card: rgba(255, 255, 255, 0.78);
    --lab-card-line: rgba(255, 255, 255, 0.9);
    --lab-card-shadow: 0 22px 50px rgba(90, 40, 120, 0.2);
    --lab-chip: rgba(255, 255, 255, 0.6);
    --lab-chip-line: rgba(43, 31, 69, 0.18);
    --lab-hover: rgba(255, 255, 255, 0.95);
    --lab-focus: #6e4482;
    --lab-link: #5b3478;
    /* Dot colors, read by the canvas script as "r g b": cloud shade, cloud light, pointer glow. */
    --lab-dot-deep: 180 132 218;
    --lab-dot-light: 236 170 214;
    --lab-dot-glow: 160 96 210;
    /* Text on the light tone gradients in the pop-up. */
    --lab-show-ink: #2a2240;
    --lab-tone-rose: linear-gradient(150deg, #f7d3e6, #c4a8f2 68%, #946fd8);
    --lab-tone-violet: linear-gradient(150deg, #e3d8f8, #9c7bd8 64%, #5e3f9a);
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .lab {
      --lab-sky: linear-gradient(170deg, #22192f 0%, #2f2242 55%, #45305f 100%);
      --lab-ink: #f3ecf8;
      --lab-muted: #c9bcdb;
      --lab-card: rgba(32, 25, 44, 0.8);
      --lab-card-line: rgba(255, 255, 255, 0.14);
      --lab-card-shadow: 0 22px 50px rgba(0, 0, 0, 0.45);
      --lab-chip: rgba(255, 255, 255, 0.07);
      --lab-chip-line: rgba(255, 255, 255, 0.22);
      --lab-hover: rgba(255, 255, 255, 0.14);
      --lab-focus: #d7b8e4;
      --lab-link: #e2c6ee;
      --lab-dot-deep: 120 82 170;
      --lab-dot-light: 230 166 214;
      --lab-dot-glow: 215 184 228;
    }
  }
  :global(:root[data-theme='dark']) .lab {
    --lab-sky: linear-gradient(170deg, #22192f 0%, #2f2242 55%, #45305f 100%);
    --lab-ink: #f3ecf8;
    --lab-muted: #c9bcdb;
    --lab-card: rgba(32, 25, 44, 0.8);
    --lab-card-line: rgba(255, 255, 255, 0.14);
    --lab-card-shadow: 0 22px 50px rgba(0, 0, 0, 0.45);
    --lab-chip: rgba(255, 255, 255, 0.07);
    --lab-chip-line: rgba(255, 255, 255, 0.22);
    --lab-hover: rgba(255, 255, 255, 0.14);
    --lab-focus: #d7b8e4;
    --lab-link: #e2c6ee;
    --lab-dot-deep: 120 82 170;
    --lab-dot-light: 230 166 214;
    --lab-dot-glow: 215 184 228;
  }

  /* Compact: text and controls on the left, the ring on the right from 900px; stacked below. */
  .lab-stage {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: grid;
    gap: 20px;
    align-items: center;
    padding: clamp(28px, 4vw, 44px) 0 24px;
    border-radius: 28px;
    background: var(--lab-sky);
    color: var(--lab-ink);
  }
  @media (min-width: 900px) {
    .lab-stage {
      grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
      padding: 36px clamp(28px, 4vw, 52px) 32px;
      column-gap: 24px;
    }
  }
  .lab-stage :focus-visible {
    outline-color: var(--lab-focus);
  }
  .lab-canvas {
    position: absolute;
    inset: 0;
    z-index: -1;
    width: 100%;
    height: 100%;
    display: block;
  }

  .lab-head {
    display: grid;
    justify-items: center;
    gap: 10px;
    max-width: 52ch;
    margin-inline: auto;
    padding-inline: 20px;
    text-align: center;
  }
  @media (min-width: 900px) {
    .lab-head {
      justify-items: start;
      margin: 0;
      padding: 0;
      text-align: left;
    }
  }
  .lab-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 4px 12px 4px 10px;
    border-radius: var(--radius-pill);
    border: 1px solid var(--lab-chip-line);
    background: var(--lab-chip);
    font-size: 13px;
    font-weight: 600;
  }
  .lab-head h2 {
    margin: 0;
    font-size: clamp(26px, 3.2vw, 34px);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.15;
    text-wrap: balance;
  }
  .lab-head p {
    margin: 0;
    font-size: 16px;
    line-height: 1.55;
    color: var(--lab-muted);
  }

  /* ---- Cards (no JS: a plain grid) ---- */
  .lab-car {
    width: 100%;
    display: grid;
    gap: 12px;
    min-width: 0;
  }
  .lab-track {
    margin: 0;
    padding: 0 clamp(16px, 4vw, 40px);
    list-style: none;
    display: grid;
    gap: 16px;
    grid-template-columns: repeat(auto-fit, minmax(230px, 280px));
    justify-content: center;
  }
  .lab-card {
    position: relative;
    display: grid;
    gap: 10px;
    padding: 9px 9px 12px;
    border-radius: 20px;
    border: 1px solid var(--lab-card-line);
    background: var(--lab-card);
    -webkit-backdrop-filter: blur(14px) saturate(1.2);
    backdrop-filter: blur(14px) saturate(1.2);
    box-shadow: var(--lab-card-shadow);
    color: var(--lab-ink);
  }
  .lab-cover {
    position: relative;
    aspect-ratio: 16 / 10;
    border-radius: 13px;
    overflow: hidden;
    display: grid;
    place-items: center;
    background: var(--lab-tone-rose);
  }
  .lab-cover[data-tone='violet'],
  .lab-show[data-tone='violet'] {
    background: var(--lab-tone-violet);
  }
  .lab-ht {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(rgba(255, 255, 255, 0.55) 1.1px, transparent 1.5px);
    background-size: 8px 8px;
    -webkit-mask-image: radial-gradient(circle at 80% 18%, #000 0, transparent 62%);
    mask-image: radial-gradient(circle at 80% 18%, #000 0, transparent 62%);
    pointer-events: none;
  }
  .lab-mini {
    position: absolute;
    bottom: -48%;
    width: 36%;
    aspect-ratio: 390 / 844;
    border-radius: 13px;
    border: 4px solid var(--bezel);
    overflow: hidden;
    background: var(--raise);
    transform: translateX(-28%) rotate(-7deg);
    box-shadow: 0 14px 30px rgba(30, 10, 50, 0.4);
  }
  .lab-mini--back {
    z-index: -1;
    transform: translateX(34%) translateY(-6%) rotate(8deg);
  }
  .lab-mini img,
  .lab-phone img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
    display: block;
  }
  .lab-miniwin {
    position: absolute;
    left: 9%;
    right: -6%;
    top: 14%;
    bottom: -20%;
    display: grid;
    grid-template-rows: auto 1fr;
    border-radius: 10px 0 0 0;
    overflow: hidden;
    border: 1px solid var(--line);
    background: var(--raise);
    box-shadow: 0 14px 30px rgba(30, 10, 50, 0.35);
  }
  .lab-winbar {
    display: flex;
    gap: 5px;
    padding: 7px 9px;
    background: var(--surface);
    border-bottom: 1px solid var(--line);
  }
  .lab-winbar i {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--line);
  }
  .lab-tx {
    display: grid;
    gap: 5px;
    padding-inline: 5px;
  }
  .lab-tx h3 {
    margin: 0;
    font-size: 17px;
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  .lab-tx p {
    margin: 0;
    font-size: 14px;
    line-height: 1.45;
    color: var(--lab-muted);
  }

  /* Status: shape AND word, never color alone. */
  .lab-status,
  .lab-pill {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 3px 9px 3px 7px;
    border-radius: var(--radius-pill);
    font-size: 12px;
    font-weight: 600;
    line-height: 1.2;
    white-space: nowrap;
  }
  .lab-status {
    border: 1px solid var(--lab-chip-line);
    background: var(--lab-chip);
    color: var(--lab-ink);
  }
  .lab-status i,
  .lab-pill i {
    display: block;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    flex: none;
  }
  .lab-status--shipped i {
    width: 5px;
    height: 9px;
    border-radius: 0;
    border: solid currentColor;
    border-width: 0 2px 2px 0;
    transform: translateY(-1px) rotate(45deg);
    margin-inline: 2px 1px;
  }
  .lab-status--active i {
    background: currentColor;
    box-shadow: 0 0 0 3px color-mix(in srgb, currentColor 25%, transparent);
  }
  .lab-status--paused i {
    border: 2px solid currentColor;
  }
  .lab-status--planned {
    border-style: dashed;
  }
  .lab-status--planned i {
    border: 1.5px dashed currentColor;
  }

  .lab-open,
  .lab-nojs {
    justify-self: start;
    align-items: center;
    gap: 6px;
    min-height: 44px;
    margin-block: -6px -10px;
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    font-size: 14px;
    font-weight: 600;
    color: var(--lab-link);
    text-decoration: underline;
    text-underline-offset: 3px;
    cursor: pointer;
  }
  .lab-nojs {
    display: inline-flex;
  }
  .lab-open {
    display: none;
  }
  /* The whole card opens it. */
  .lab-open::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 20px;
  }
  .lab-open:focus-visible {
    outline: none;
  }
  .lab-open:focus-visible::after {
    outline: 2px solid var(--lab-focus);
    outline-offset: 3px;
  }

  .lab-nav {
    justify-self: center;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 5px;
    border-radius: var(--radius-pill);
    border: 1px solid var(--lab-card-line);
    background: var(--lab-card);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
  }
  .lab-nav[hidden],
  .lab-screen[hidden] {
    display: none;
  }
  .lab-nav button {
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    border-radius: var(--radius-pill);
    border: 1px solid var(--lab-chip-line);
    background: var(--lab-chip);
    color: var(--lab-ink);
    cursor: pointer;
  }
  .lab-nav button:hover {
    background: var(--lab-hover);
  }
  .lab-count {
    min-width: 48px;
    text-align: center;
    font-size: 14px;
    font-variant-numeric: tabular-nums;
  }

  /* ---- With JS: the 3D ring ---- */
  :global(.js) .lab-open {
    display: inline-flex;
  }
  :global(.js) .lab-nojs {
    display: none;
  }
  :global(.js) .lab-track {
    display: block;
    position: relative;
    height: var(--lab-th, 360px);
    padding: 0;
    perspective: 1100px;
    touch-action: pan-y;
    user-select: none;
    -webkit-user-select: none;
  }
  :global(.js) .lab-slide {
    --cw: min(270px, 72vw);
    position: absolute;
    top: 0;
    left: 50%;
    width: var(--cw);
    margin-left: calc(var(--cw) / -2);
    transform: translateX(calc(var(--o, 0) * 78%)) translateZ(calc(var(--ao, 0) * -150px))
      rotateY(calc(var(--o, 0) * -34deg));
    filter: saturate(calc(1 - var(--ao, 0) * 0.3));
    opacity: calc(1 - var(--ao, 0) * 0.15);
    transform-origin: 50% 60%;
  }
  :global(.js) .lab-slide[data-far] {
    visibility: hidden;
  }
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .lab-slide {
      transition:
        transform 0.65s cubic-bezier(0.22, 0.9, 0.24, 1),
        filter 0.5s,
        opacity 0.5s;
    }
  }

  /* ---- Pop-up (site tokens; its stage takes the project's tone) ---- */
  /* Tailwind's reset zeroes margins; a modal dialog centers itself with margin: auto. */
  .lab-dlg {
    margin: auto;
    width: 100%;
    max-width: min(960px, calc(100vw - 32px));
    max-height: calc(100dvh - 32px);
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--ink);
  }
  .lab-dlg::backdrop {
    background: rgba(12, 9, 18, 0.62);
    -webkit-backdrop-filter: blur(4px);
    backdrop-filter: blur(4px);
  }
  .lab-sheet {
    position: relative;
    display: grid;
    grid-template-columns: 1fr;
    max-height: calc(100dvh - 32px);
    overflow: auto;
    border-radius: 24px;
    border: 1px solid var(--line);
    background: var(--bg);
    box-shadow: var(--shadow-lift);
  }
  @media (min-width: 760px) {
    .lab-sheet--phone {
      grid-template-columns: 320px minmax(0, 1fr);
    }
    .lab-sheet--window {
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    }
  }
  .lab-close {
    position: absolute;
    top: 12px;
    right: 12px;
    z-index: 3;
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    border-radius: var(--radius-pill);
    border: 1px solid var(--muted);
    background: var(--raise);
    color: var(--ink);
    cursor: pointer;
  }
  .lab-close:hover {
    background: var(--surface);
  }
  .lab-show {
    position: relative;
    display: grid;
    align-content: center;
    justify-items: center;
    gap: 14px;
    padding: 30px 20px 20px;
    overflow: hidden;
    background: var(--lab-tone-rose);
  }
  .lab-show .lab-ht {
    -webkit-mask-image: linear-gradient(#000, transparent 70%);
    mask-image: linear-gradient(#000, transparent 70%);
  }
  .lab-screens {
    position: relative;
    width: 100%;
    display: grid;
    justify-items: center;
  }
  .lab-screen {
    margin: 0;
    display: grid;
    justify-items: center;
    gap: 12px;
    width: 100%;
  }
  .lab-screen figcaption {
    max-width: 32ch;
    min-height: 2.9em;
    text-align: center;
    font-size: 14px;
    line-height: 1.45;
    color: var(--lab-show-ink);
  }
  .lab-phone {
    position: relative;
    width: min(230px, 60vw);
    aspect-ratio: 390 / 844;
    padding: 8px;
    border-radius: 34px;
    border: 1px solid var(--bezel-edge);
    background: var(--bezel);
    box-shadow: var(--shadow-lift);
  }
  .lab-phone img {
    border-radius: 27px;
    background: var(--raise);
  }
  .lab-cut {
    position: absolute;
    top: 15px;
    left: 50%;
    z-index: 2;
    width: 58px;
    height: 16px;
    border-radius: 10px;
    background: var(--bezel);
    transform: translateX(-50%);
  }
  .lab-window {
    width: 100%;
    max-width: 480px;
    min-height: 300px;
    display: grid;
    grid-template-rows: auto 1fr;
    border-radius: var(--radius-frame);
    overflow: hidden;
    border: 1px solid var(--line);
    background: var(--raise);
    box-shadow: var(--shadow-lift);
  }
  .lab-ctrls {
    position: relative;
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .lab-ctrls button {
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    border-radius: var(--radius-pill);
    border: 1px solid var(--muted);
    background: var(--raise);
    color: var(--ink);
    cursor: pointer;
  }
  .lab-ctrls button:hover {
    background: var(--accent-tint);
  }
  .lab-dots {
    display: flex;
    gap: 6px;
  }
  .lab-dots i {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: color-mix(in srgb, var(--lab-show-ink) 30%, transparent);
  }
  .lab-dots i.on {
    width: 18px;
    border-radius: 4px;
    background: var(--lab-show-ink);
  }

  .lab-body {
    display: grid;
    align-content: start;
    gap: 16px;
    min-width: 0;
    padding: clamp(22px, 4vw, 36px);
  }
  .lab-kicker {
    font-size: 13px;
    color: var(--muted);
  }
  .lab-body h2 {
    margin: 0;
    padding-right: 44px;
    font-size: clamp(24px, 3vw, 30px);
    font-weight: 700;
    letter-spacing: -0.015em;
  }
  .lab-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    font-size: 14px;
    color: var(--muted);
  }
  .lab-pill {
    border: 1px solid var(--line);
    background: var(--raise);
    color: var(--ink);
  }
  .lab-pill.lab-status--shipped i {
    border-color: var(--accent);
  }
  .lab-pill.lab-status--active i {
    color: var(--accent);
  }
  .lab-lead {
    margin: 0;
    font-size: 18px;
    line-height: 1.5;
  }
  .lab-notes {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 6px;
    counter-reset: n;
  }
  .lab-notes li {
    counter-increment: n;
  }
  .lab-notes li > * {
    display: grid;
    grid-template-columns: 28px 1fr;
    gap: 10px;
    width: 100%;
    padding: 6px 8px 6px 4px;
    border: 0;
    border-radius: 10px;
    background: none;
    font: inherit;
    font-size: 15.5px;
    line-height: 1.5;
    text-align: left;
    color: var(--ink);
  }
  .lab-notes li > *::before {
    content: counter(n);
    width: 26px;
    height: 26px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--accent-tint);
    color: var(--accent-strong);
    font-size: 13px;
    font-weight: 700;
  }
  .lab-notes button {
    cursor: pointer;
  }
  .lab-notes button:hover,
  .lab-notes button[aria-current='true'] {
    background: var(--surface);
  }
  .lab-notes button[aria-current='true']::before {
    background: var(--accent);
    color: var(--on-accent);
  }
  .lab-cta {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    padding: 0 20px;
    border-radius: var(--radius-pill);
    background: var(--accent);
    color: var(--on-accent);
    font-size: 15px;
    font-weight: 600;
    text-decoration: none;
  }
  .lab-cta:hover {
    background: var(--accent-strong);
  }
  .lab-small {
    margin: 0;
    font-size: 13.5px;
    color: var(--muted);
  }
</style>

<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');

  /* ---------- Carousel ---------- */
  const stage = document.querySelector<HTMLElement>('[data-lab]');
  const track = stage?.querySelector<HTMLElement>('[data-lab-track]');
  const slides = [...(stage?.querySelectorAll<HTMLElement>('[data-lab-slide]') ?? [])];
  let active = 0;

  function layout(announce: boolean) {
    const n = slides.length;
    slides.forEach((s, i) => {
      let o = i - active;
      if (n > 2) {
        if (o > n / 2) o -= n;
        if (o < -n / 2) o += n;
      }
      const ao = Math.abs(o);
      s.style.setProperty('--o', String(o));
      s.style.setProperty('--ao', String(ao));
      s.style.zIndex = String(20 - ao);
      s.toggleAttribute('data-far', ao > 2);
      s.dataset.offset = String(o);
      if (o === 0) s.removeAttribute('aria-hidden');
      else s.setAttribute('aria-hidden', 'true');
      const open = s.querySelector<HTMLButtonElement>('[data-lab-open]');
      if (open) open.tabIndex = o === 0 ? 0 : -1;
    });
    const count = stage?.querySelector('[data-lab-count]');
    if (count) count.textContent = `${active + 1} / ${n}`;
    const live = stage?.querySelector('[data-lab-live]');
    const name = slides[active]?.querySelector('h3')?.textContent ?? '';
    if (live && announce) live.textContent = `${active + 1} of ${n}: ${name}`;
  }
  function go(i: number) {
    const n = slides.length;
    active = ((i % n) + n) % n;
    layout(true);
    window.dispatchEvent(new CustomEvent('lab:move'));
  }
  function sizeTrack() {
    if (!track) return;
    const h = Math.max(...slides.map((s) => s.offsetHeight));
    track.style.setProperty('--lab-th', `${h + 28}px`);
  }

  if (stage && track && slides.length) {
    const nav = stage.querySelector<HTMLElement>('[data-lab-nav]');
    if (nav && slides.length > 1) nav.hidden = false;
    stage.querySelector('[data-lab-prev]')?.addEventListener('click', () => go(active - 1));
    stage.querySelector('[data-lab-next]')?.addEventListener('click', () => go(active + 1));

    stage.querySelector('[data-lab-car]')?.addEventListener('keydown', (e) => {
      const k = (e as KeyboardEvent).key;
      if (k === 'ArrowRight') { go(active + 1); e.preventDefault(); }
      if (k === 'ArrowLeft') { go(active - 1); e.preventDefault(); }
    });

    // Swipe. A drag never counts as a click.
    let x0: number | null = null;
    let dragged = false;
    track.addEventListener('pointerdown', (e) => { x0 = e.clientX; dragged = false; });
    track.addEventListener('pointermove', (e) => { if (x0 !== null && Math.abs(e.clientX - x0) > 8) dragged = true; });
    track.addEventListener('pointerup', (e) => {
      if (x0 === null) return;
      const dx = e.clientX - x0;
      x0 = null;
      if (Math.abs(dx) > 40) go(dx < 0 ? active + 1 : active - 1);
    });
    track.addEventListener('pointercancel', () => { x0 = null; });

    slides.forEach((s, i) => {
      s.querySelector('[data-lab-open]')?.addEventListener('click', (e) => {
        if (dragged) { dragged = false; return; }
        if (i !== active) { go(i); return; }
        const id = (e.currentTarget as HTMLElement).dataset.labOpen;
        if (id) openDialog(id, e.currentTarget as HTMLElement);
      });
    });

    layout(false);
    sizeTrack();
    window.addEventListener('resize', sizeTrack);
    document.fonts?.ready.then(sizeTrack);
    slides.forEach((s) => s.querySelectorAll('img').forEach((img) => img.addEventListener('load', sizeTrack)));
  }

  /* ---------- Pop-ups ---------- */
  let opener: HTMLElement | null = null;
  function openDialog(id: string, from: HTMLElement) {
    const dlg = document.getElementById(`lab-dlg-${id}`) as HTMLDialogElement | null;
    if (!dlg) return;
    opener = from;
    showScreen(dlg, 0);
    dlg.showModal();
  }
  function showScreen(dlg: HTMLDialogElement, i: number) {
    const screens = [...dlg.querySelectorAll<HTMLElement>('[data-lab-screen]')];
    const n = screens.length;
    const idx = ((i % n) + n) % n;
    dlg.dataset.screen = String(idx);
    screens.forEach((s, k) => (s.hidden = k !== idx));
    dlg.querySelectorAll<HTMLElement>('[data-lab-dot]').forEach((d, k) => d.classList.toggle('on', k === idx));
    dlg.querySelectorAll<HTMLElement>('[data-lab-goto]').forEach((b) => {
      b.setAttribute('aria-current', String(Number(b.dataset.labGoto) === idx && idx > 0));
    });
  }
  document.querySelectorAll<HTMLDialogElement>('[data-lab-dialog]').forEach((dlg) => {
    const cur = () => Number(dlg.dataset.screen ?? 0);
    dlg.querySelector('[data-lab-sprev]')?.addEventListener('click', () => showScreen(dlg, cur() - 1));
    dlg.querySelector('[data-lab-snext]')?.addEventListener('click', () => showScreen(dlg, cur() + 1));
    dlg.querySelectorAll<HTMLElement>('[data-lab-goto]').forEach((b) =>
      b.addEventListener('click', () => showScreen(dlg, Number(b.dataset.labGoto))),
    );
    dlg.querySelector('[data-lab-close]')?.addEventListener('click', () => dlg.close());
    dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
    dlg.addEventListener('keydown', (e) => {
      if (!dlg.querySelector('[data-lab-snext]')) return;
      if (e.key === 'ArrowRight') showScreen(dlg, cur() + 1);
      if (e.key === 'ArrowLeft') showScreen(dlg, cur() - 1);
    });
    dlg.addEventListener('close', () => opener?.focus());
  });

  /* ---------- Clouds made of dots ----------
     Three banks of cumulus are painted once (white on black) on small offscreen canvases.
     Each frame they drift and shift with the pointer (parallax), and are sampled on a grid:
     a brighter sample is a bigger dot. Dots swell and glow under the pointer, and stay dim
     behind the heading so its text keeps its contrast. */
  const canvas = stage?.querySelector<HTMLCanvasElement>('.lab-canvas');
  const ctx = canvas?.getContext('2d');
  if (stage && canvas && ctx) {
    type Bank = { c: HTMLCanvasElement; depth: number; speed: number };
    const rgb = (name: string) =>
      getComputedStyle(stage).getPropertyValue(name).trim().split(/\s+/).map(Number) as [number, number, number];
    let DEEP = rgb('--lab-dot-deep'), LIGHT = rgb('--lab-dot-light'), GLOW = rgb('--lab-dot-glow');

    const SCALE = 3; // the cloud banks are painted at a third of the stage's size
    let w = 0, h = 0, raf = 0, last = 0, visible = false;
    let banks: Bank[] = [];
    let W = 0;
    const off = document.createElement('canvas');
    const og = off.getContext('2d', { willReadFrequently: true });
    let quiet: { cx: number; cy: number; rx: number; ry: number }[] = [];
    const ptr = { x: 0.5, y: 0.5, tx: 0.5, ty: 0.5, px: -9999, py: -9999, on: false };

    const rnd = (seed: number) => () => { seed = (seed * 16807) % 2147483647; return (seed - 1) / 2147483646; };
    function bank(bw: number, bh: number, seed: number, count: number, y0: number, y1: number, size: number, a: number) {
      const c = document.createElement('canvas');
      c.width = bw; c.height = bh;
      const g = c.getContext('2d');
      if (!g) return c;
      const r = rnd(seed);
      for (let k = 0; k < count; k++) {
        const cx = r() * bw, base = bh * (y0 + r() * (y1 - y0)), sw = bw * size * (0.7 + r() * 0.6), R = sw * 0.16;
        const n = 10 + Math.floor(r() * 8);
        const puffs: [number, number, number][] = [];
        for (let i = 0; i < n; i++) {
          const u = i / (n - 1) - 0.5, hump = Math.cos(u * Math.PI);
          puffs.push([cx + u * sw + (r() - 0.5) * R * 0.6, base - hump * R * (0.6 + r() * 0.7), R * (0.55 + hump * 0.55 + r() * 0.25)]);
        }
        for (const [x, y, rad] of puffs) {
          const gr = g.createRadialGradient(x - rad * 0.2, y - rad * 0.25, 0, x, y, rad);
          gr.addColorStop(0, `rgba(255,255,255,${a})`);
          gr.addColorStop(0.55, `rgba(255,255,255,${a * 0.75})`);
          gr.addColorStop(1, 'rgba(255,255,255,0)');
          g.fillStyle = gr;
          g.beginPath(); g.arc(x, y, rad, 0, 6.2832); g.fill();
        }
      }
      return c;
    }

    function measure() {
      const d = Math.min(window.devicePixelRatio || 1, 2);
      const r = stage!.getBoundingClientRect();
      w = r.width; h = r.height;
      canvas!.width = Math.round(w * d); canvas!.height = Math.round(h * d);
      ctx!.setTransform(d, 0, 0, d, 0, 0);
      off.width = Math.ceil(w / SCALE); off.height = Math.ceil(h / SCALE);
      W = Math.ceil((w * 1.5) / SCALE);
      const bh = off.height;
      banks = [
        { c: bank(W, bh, 13, 4, 0.18, 0.4, 0.2, 0.7), depth: 10, speed: 0.0013 },
        { c: bank(W, bh, 16, 5, 0.55, 0.78, 0.26, 0.85), depth: 22, speed: 0.0024 },
        { c: bank(W, bh, 20, 6, 0.95, 1.1, 0.34, 1), depth: 36, speed: 0.0037 },
      ];
      quiet = [...stage!.querySelectorAll<HTMLElement>('[data-lab-head] > *')].map((el) => {
        const b = el.getBoundingClientRect();
        return { cx: b.left - r.left + b.width / 2, cy: b.top - r.top + b.height / 2, rx: b.width / 2 + 60, ry: b.height / 2 + 30 };
      });
      draw(performance.now());
    }

    function draw(t: number) {
      if (!og) return;
      const still = reduce.matches;
      if (!still) { ptr.x += (ptr.tx - ptr.x) * 0.06; ptr.y += (ptr.ty - ptr.y) * 0.06; }
      const ow = off.width, oh = off.height;
      og.fillStyle = '#000';
      og.fillRect(0, 0, ow, oh);
      for (const b of banks) {
        const drift = still ? 0 : (t * b.speed) % W;
        const x = -drift - ((ptr.x - 0.5) * b.depth * 2) / SCALE - (W - ow) / 2;
        const y = -((ptr.y - 0.5) * b.depth) / SCALE;
        og.drawImage(b.c, x, y);
        if (x + W < ow) og.drawImage(b.c, x + W, y);
        if (x > 0) og.drawImage(b.c, x - W, y);
      }
      const data = og.getImageData(0, 0, ow, oh).data;
      ctx!.clearRect(0, 0, w, h);
      const sp = w < 600 ? 9 : 11;
      for (let y = sp / 2; y < h; y += sp) {
        const row = Math.min(oh - 1, Math.floor(y / SCALE)) * ow;
        for (let x = sp / 2; x < w; x += sp) {
          let v = (data[(row + Math.min(ow - 1, Math.floor(x / SCALE))) * 4] ?? 0) / 255;
          v = Math.pow(v, 1.4) * 1.3;
          let vp = 0;
          if (ptr.on && !still) {
            const dx = x - ptr.px, dy = y - ptr.py;
            vp = Math.exp(-(dx * dx + dy * dy) / (2 * 70 * 70));
          }
          v = Math.min(1, v + vp * 0.6);
          for (const q of quiet) {
            const e = ((x - q.cx) / q.rx) ** 2 + ((y - q.cy) / q.ry) ** 2;
            if (e < 1) v *= 0.08 + 0.92 * e * e * e;
          }
          if (v < 0.06) continue;
          const m = Math.min(1, v);
          const c = DEEP.map((d, j) => Math.round(d + (LIGHT[j]! - d) * m * 0.7 + (GLOW[j]! - d) * vp * 0.5));
          ctx!.fillStyle = `rgba(${c[0]},${c[1]},${c[2]},${0.3 + 0.7 * v})`;
          ctx!.beginPath();
          ctx!.arc(x, y, v * sp * 0.48, 0, 6.2832);
          ctx!.fill();
        }
      }
    }
    function frame(t: number) {
      raf = 0;
      if (t - last > 32) { last = t; draw(t); }
      loop();
    }
    function loop() {
      if (visible && !reduce.matches && !raf) raf = requestAnimationFrame(frame);
    }
    const recolor = () => {
      DEEP = rgb('--lab-dot-deep'); LIGHT = rgb('--lab-dot-light'); GLOW = rgb('--lab-dot-glow');
      draw(performance.now());
    };

    stage.addEventListener('pointermove', (e) => {
      const r = stage.getBoundingClientRect();
      ptr.tx = (e.clientX - r.left) / r.width; ptr.ty = (e.clientY - r.top) / r.height;
      ptr.px = e.clientX - r.left; ptr.py = e.clientY - r.top; ptr.on = true;
    });
    stage.addEventListener('pointerleave', () => { ptr.tx = 0.5; ptr.ty = 0.5; ptr.on = false; });
    new IntersectionObserver(([e]) => { visible = !!e?.isIntersecting; loop(); }).observe(stage);
    new ResizeObserver(measure).observe(stage);
    reduce.addEventListener('change', () => { draw(performance.now()); loop(); });
    window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', recolor);
    new MutationObserver(recolor).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
    measure();
  }
</script>
