---
import { CV_HREF, CV_SIZE_LABEL } from '../lib/cv';

const EMAIL = 'lirazhazala@gmail.com';
const LINKEDIN = 'https://www.linkedin.com/in/liraz-hazala-perez';
const year = new Date().getFullYear();
---

<!-- The site's main call to action, on every page: one soft panel, then a quiet footer line. -->
<footer id="contact" tabindex="-1" class="mt-8" aria-labelledby="contact-h">
  <div class="mx-auto max-w-content px-[clamp(16px,5vw,56px)]">
    <div class="grid gap-1.5 rounded-card bg-accent-tint px-[clamp(24px,5vw,56px)] py-[clamp(32px,5vw,56px)]">
      <!-- Set in Caveat like the signature: a personal note, not a section label. -->
      <h2 id="contact-h" class="m-0 font-signature font-semibold text-[clamp(44px,5vw,52px)] leading-[1.05] text-accent-strong">
        Let's talk
      </h2>
      <p class="m-0 text-ink text-[17px] leading-relaxed max-w-[52ch]">
        Hiring a product designer who builds? A sentence is enough to start.
      </p>

      <!-- The address is plain, selectable text (always works), with a mailto link and, once JS
           is on, a copy button. Without JS the copy button stays hidden. -->
      <div class="flex flex-wrap items-center gap-1 pt-2">
        <span
          id="contact-email"
          class="inline-flex items-center min-h-[44px] px-[14px] rounded-pill bg-raise text-ink text-[15px] font-medium select-all"
          >{EMAIL}</span
        >
        <button
          type="button"
          class="copy-btn items-center gap-[6px] min-h-[44px] px-[14px] rounded-pill border border-muted bg-raise text-ink text-[15px] font-medium hover:bg-surface transition-colors cursor-pointer"
          data-copy={EMAIL}
          aria-label="Copy email address"
        >
          <svg
            width="15"
            height="15"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
            focusable="false"
          >
            <rect x="9" y="9" width="11" height="11" rx="2"></rect>
            <path d="M5 15V6a2 2 0 0 1 2-2h9"></path>
          </svg>
          <span data-copy-label>Copy</span>
        </button>
        <a
          class="inline-flex items-center min-h-[44px] px-[18px] rounded-pill bg-accent text-on-accent text-[15px] font-medium no-underline hover:bg-accent-strong transition-colors"
          href={`mailto:${EMAIL}`}>Email me</a
        >
        <a
          class="inline-flex items-center min-h-[44px] px-[18px] rounded-pill border border-muted bg-raise text-ink text-[15px] font-medium no-underline hover:bg-surface transition-colors"
          href={LINKEDIN}
          target="_blank"
          rel="noopener noreferrer">LinkedIn<span class="sr-only-text"> (opens in a new tab)</span></a
        >
      </div>
      <p class="m-0 min-h-[1.2em] text-[13px] text-muted" role="status" aria-live="polite" data-copy-status></p>
    </div>

    <div class="flex flex-wrap items-center justify-between gap-x-3 gap-y-0.5 py-2 text-[13px] text-muted">
      <p class="m-0">© {year} Liraz Hazala Perez. Designed and built by me.</p>
      <ul role="list" class="m-0 p-0 list-none flex gap-2">
        <li>
          <a class="prose-link inline-flex items-center min-h-[44px]" href={CV_HREF} download>
            CV<span class="sr-only-text">, PDF download, {CV_SIZE_LABEL}</span>
          </a>
        </li>
        <li><a class="prose-link inline-flex items-center min-h-[44px]" href="/accessibility">Accessibility</a></li>
      </ul>
    </div>
  </div>
</footer>

<style>
  /* No JS, no copy button: the text above is selectable and the mailto link works. */
  .copy-btn {
    display: none;
  }
  :global(.js) .copy-btn {
    display: inline-flex;
  }
</style>

<script>
  const button = document.querySelector<HTMLButtonElement>('[data-copy]');
  const label = document.querySelector<HTMLElement>('[data-copy-label]');
  const status = document.querySelector<HTMLElement>('[data-copy-status]');
  const emailEl = document.getElementById('contact-email');

  if (button && label && status) {
    let timer = 0;
    const reset = () => {
      label.textContent = 'Copy';
      status.textContent = '';
    };

    button.addEventListener('click', async () => {
      const text = button.dataset.copy ?? '';
      window.clearTimeout(timer);
      try {
        await navigator.clipboard.writeText(text);
        label.textContent = 'Copied';
        status.textContent = 'Email address copied.';
      } catch {
        // Clipboard blocked (insecure context, permissions): select the text so the
        // visitor can copy it with the keyboard.
        if (emailEl) {
          const range = document.createRange();
          range.selectNodeContents(emailEl);
          const selection = window.getSelection();
          selection?.removeAllRanges();
          selection?.addRange(range);
        }
        label.textContent = 'Selected';
        status.textContent = 'Email address selected. Press Control C or Command C to copy.';
      }
      timer = window.setTimeout(reset, 3000);
    });
  }
</script>
