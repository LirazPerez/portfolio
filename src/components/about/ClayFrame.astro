---
/**
 * A soft clay frame around whatever is inside it (a certificate's paper card).
 * Drawn in CSS from the `--clay` tokens, which are mixed from the accent family: a rounded
 * clay purple border with a gentle highlight on top and an inner shadow where it meets the
 * paper. The paper is `--raise` in light mode and `--surface` in dark mode.
 *
 * To use a real clay frame image instead, pass `image` (an imported image whose middle is
 * transparent or ignored) and `slice` (px of the source that are frame, as in border-image):
 * the CSS frame is swapped for that image as a border-image, and the paper stays the same.
 */
import type { ImageMetadata } from 'astro';

interface Props {
  image?: ImageMetadata;
  /** border-image-slice for `image`, in source pixels. */
  slice?: number;
  class?: string;
}
const { image, slice = 120, class: className } = Astro.props;
const style = image ? `--frame-image: url(${image.src}); --frame-slice: ${slice};` : undefined;
---

<div class:list={['clay-frame', image && 'clay-frame--image', className]} style={style}>
  <div class="paper bg-raise text-ink dark:bg-surface"><slot /></div>
</div>

<style>
  .clay-frame {
    --frame: 6px;
    height: 100%;
    padding: var(--frame);
    border-radius: var(--radius-card);
    background:
      radial-gradient(120% 90% at 20% 0%, var(--clay-hi), transparent 60%),
      var(--clay);
    box-shadow:
      inset 0 1.5px 1px color-mix(in srgb, var(--clay-hi) 90%, transparent),
      inset 0 -2px 4px color-mix(in srgb, var(--clay-lo) 70%, transparent),
      var(--shadow);
  }
  .clay-frame--image {
    background: none;
    box-shadow: none;
    border-radius: 0;
    padding: 0;
    border: var(--frame) solid transparent;
    border-image: var(--frame-image) var(--frame-slice) fill / var(--frame) / 0 stretch;
  }
  .paper {
    height: 100%;
    border-radius: 10px;
    /* The frame's edge casts a soft shadow onto the paper. */
    box-shadow:
      inset 0 1.5px 4px color-mix(in srgb, var(--clay-lo) 45%, transparent),
      inset 0 0 0 1px color-mix(in srgb, var(--clay-lo) 30%, transparent);
  }
</style>
