---
/**
 * A calm stand-in for a project whose case study isn't written yet: the same phone frame,
 * a neutral screen, the project's name and "Case study coming soon". Tokens only, so it
 * follows both themes. One image to assistive tech.
 */
import Phone from './Phone.astro';

interface Props {
  title: string;
}
const { title } = Astro.props;
---

<Phone label={`${title}: case study coming soon.`} class="soon-phone">
  <div class="soon">
    <span class="mark" aria-hidden="true"></span>
    <p class="name">{title}</p>
    <p class="line">Case study coming soon</p>
  </div>
</Phone>

<style>
  .soon {
    position: absolute;
    inset: 0;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 2.5cqi;
    padding: 10cqi;
    text-align: center;
    background:
      radial-gradient(90% 60% at 50% 30%, var(--accent-tint) 0%, transparent 70%),
      var(--surface);
  }
  .mark {
    width: 14cqi;
    height: 14cqi;
    margin-bottom: 2cqi;
    border-radius: 30%;
    border: 1.5px dashed var(--muted);
  }
  p {
    margin: 0;
  }
  .name {
    font-size: max(15px, 8cqi);
    font-weight: 620;
    letter-spacing: -0.01em;
    color: var(--ink);
  }
  .line {
    font-size: max(12px, 5cqi);
    color: var(--muted);
  }
</style>
