---
import '../styles/global.css';
import geistUrl from '@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url';
import caveatUrl from '@fontsource/caveat/files/caveat-latin-600-normal.woff2?url';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  /** Link preview image (path or URL) and its alt text; every page shares /og.png unless it passes its own. */
  image?: string;
  imageAlt?: string;
  /** Keep the page out of search results (a page that nothing links to yet). */
  noindex?: boolean;
}

const {
  title,
  description = 'Liraz Hazala Perez, product designer. Nine years running complex operations, now designing and building products.',
  image = '/og.png',
  noindex = false,
  imageAlt = 'Liraz Hazala Perez, Product Designer. I design and build products. Beside the words, a small heap of clay objects: a beret, a laptop, the Statue of Liberty, a running shoe and Bobby the dog.',
} = Astro.props;
const fullTitle = title === 'Home' ? 'Liraz Hazala Perez · Product Designer' : `${title} · Liraz Hazala Perez`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="color-scheme" content="light dark" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href={geistUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={caveatUrl} as="font" type="font/woff2" crossorigin />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={imageAlt} />
    <!-- Apply the saved theme before first paint: no flash. Must stay inline and first. -->
    <script is:inline>
      (function () {
        var root = document.documentElement;
        root.classList.add('js');
        try {
          var t = localStorage.getItem('lh-theme');
          if (t === 'light' || t === 'dark') root.setAttribute('data-theme', t);
        } catch (e) {}
      })();
    </script>
  </head>
  <body class="flex flex-col pb-[calc(88px+env(safe-area-inset-bottom,0px))] md:pb-0">
    <a class="skip-link" href="#main">Skip to content</a>
    <Nav />
    <main id="main" tabindex="-1" class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
